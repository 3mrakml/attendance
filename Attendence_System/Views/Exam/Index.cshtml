@model List<Attendence_System.Models.Exam>

@{
    ViewData["Title"] = "الامتحانات";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:justify-between md:items-center bg-white p-4 sm:p-6 rounded-2xl shadow-sm border border-slate-100">
        <div class="mb-4 md:mb-0">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-800">الامتحانات</h2>
            <p class="text-slate-500 mt-1 text-sm sm:text-base">إدارة امتحانات المواد الدراسية وإدخال درجات الطلاب.</p>
        </div>
        <button type="button" onclick="document.getElementById('createExamModal').classList.remove('hidden')" class="btn btn-primary">
            <i data-lucide="plus" class="w-4 h-4"></i> إنشاء امتحان جديد
        </button>
    </div>



    <!-- Exams Table -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-100">
                <thead class="bg-slate-50/50">
                    <tr>
                        <th class="px-6 py-4 text-right text-sm font-bold text-slate-500">عنوان الامتحان</th>
                        <th class="px-6 py-4 text-right text-sm font-bold text-slate-500">المادة</th>
                        <th class="px-6 py-4 text-right text-sm font-bold text-slate-500">الصف</th>
                        <th class="px-6 py-4 text-right text-sm font-bold text-slate-500">التاريخ</th>
                        <th class="px-6 py-4 text-center text-sm font-bold text-slate-500">الدرجة القصوى</th>
                        <th class="px-6 py-4 text-center text-sm font-bold text-slate-500">إجراءات</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-slate-100">
                    @if (Model.Any())
                    {
                        foreach (var exam in Model)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="px-6 py-4 whitespace-nowrap font-bold text-slate-800">@exam.Title</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600">
                                    @if (exam.Course != null)
                                    {
                                        <span class="px-3 py-1 rounded-full bg-indigo-100 text-indigo-800 font-semibold text-xs">@exam.Course.Name</span>
                                    }
                                    else
                                    {
                                        <span class="px-3 py-1 rounded-full bg-fuchsia-100 text-fuchsia-800 font-semibold text-xs">امتحان شامل</span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600">
                                    <span class="px-3 py-1 rounded-full bg-amber-100 text-amber-800 font-semibold text-xs">@exam.Grade?.Name</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600" dir="ltr">@exam.Date.ToString("yyyy-MM-dd")</td>
                                <td class="px-6 py-4 whitespace-nowrap text-center font-black text-slate-800">@exam.MaxScore</td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    <div class="flex items-center justify-center gap-2">
                                        <a href="@Url.Action("Scores", new { id = Hashids.Encode(exam.ExamId) })" class="btn btn-neutral text-xs py-1.5 px-3">
                                            <i data-lucide="pencil" class="w-3.5 h-3.5"></i> إدخال الدرجات
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@Hashids.Encode(exam.ExamId)" method="post" class="js-delete-form">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="action-btn action-btn-danger" title="حذف الامتحان"
                                                    data-confirm-message="هل أنت متأكد من حذف امتحان &quot;@exam.Title&quot;؟">
                                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-16 text-center text-slate-500">
                                <div class="flex flex-col items-center gap-3">
                                    <i data-lucide="file-x" class="w-12 h-12 text-slate-300"></i>
                                    <p class="font-semibold">لا توجد امتحانات حتى الآن.</p>
                                    <p class="text-sm text-slate-400">اضغط على "إنشاء امتحان جديد" للبدء.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create Exam Modal -->
<div id="createExamModal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md">
        <div class="flex items-center justify-between p-6 border-b border-slate-100">
            <h3 class="text-lg font-bold text-slate-800">إنشاء امتحان جديد</h3>
            <button type="button" onclick="document.getElementById('createExamModal').classList.add('hidden')" class="p-2 rounded-xl hover:bg-slate-100 transition-colors text-slate-500">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        <form asp-action="Create" method="post" class="p-6 space-y-4">
            @Html.AntiForgeryToken()
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">عنوان الامتحان</label>
                <input type="text" name="title" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all" placeholder="مثال: اختبار الفصل الأول" />
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">المادة</label>
                    <select name="courseId" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 transition-all bg-white">
                        <option value="">-- امتحان شامل (جميع المواد) --</option>
                        @if (ViewBag.Courses != null)
                        {
                            foreach (var course in ViewBag.Courses)
                            {
                                <option value="@course.CourseId">@course.Name</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">الصف</label>
                    <select name="gradeId" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 transition-all bg-white">
                        <option value="">-- اختر الصف --</option>
                        @if (ViewBag.Grades != null)
                        {
                            foreach (var grade in ViewBag.Grades)
                            {
                                <option value="@grade.GradeId">@grade.Name</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">التاريخ</label>
                    <input type="date" name="date" required value="@Attendence_System.Helpers.AppTime.Today.ToString("yyyy-MM-dd")" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 transition-all" dir="ltr" />
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">الدرجة القصوى</label>
                    <input type="number" name="maxScore" required value="100" min="1" step="any" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 transition-all" dir="ltr" />
                </div>
            </div>
            <div class="border-t border-slate-100 pt-4 flex gap-3">
                <button type="button" class="btn btn-neutral flex-1" onclick="document.getElementById('createExamModal').classList.add('hidden')">إلغاء</button>
                <button type="submit" class="btn btn-primary flex-1">
                    <i data-lucide="save" class="w-4 h-4"></i> إنشاء وإدخال الدرجات
                </button>
            </div>
        </form>
    </div>
</div>
