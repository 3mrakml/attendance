@model List<Attendence_System.Models.StudentExam>

@{
    var exam = ViewBag.Exam as Attendence_System.Models.Exam;
    ViewData["Title"] = $"درجات امتحان - {exam?.Title}";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:justify-between md:items-center bg-white p-4 sm:p-6 rounded-2xl shadow-sm border border-slate-100">
        <div class="mb-4 md:mb-0">
            <h2 class="text-xl sm:text-2xl font-extrabold text-slate-800">@exam?.Title</h2>
            <div class="flex flex-wrap gap-3 mt-2 text-sm text-slate-500 font-medium">
                <span class="flex items-center gap-1.5">
                    <i data-lucide="book-open" class="w-4 h-4 text-indigo-500"></i>
                    @if (exam?.Course != null)
                    {
                        <span class="px-2 py-0.5 rounded-full bg-indigo-100 text-indigo-800 font-bold text-xs">@exam.Course.Name</span>
                    }
                    else
                    {
                        <span class="px-2 py-0.5 rounded-full bg-fuchsia-100 text-fuchsia-800 font-bold text-xs">امتحان شامل</span>
                    }
                </span>
                <span class="flex items-center gap-1.5">
                    <i data-lucide="graduation-cap" class="w-4 h-4 text-amber-500"></i>
                    <span class="px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 font-bold text-xs">@exam?.Grade?.Name</span>
                </span>
                <span class="flex items-center gap-1.5" dir="ltr">
                    <i data-lucide="calendar" class="w-4 h-4 text-slate-400"></i>
                    @exam?.Date.ToString("yyyy-MM-dd")
                </span>
                <span class="flex items-center gap-1.5">
                    <i data-lucide="award" class="w-4 h-4 text-slate-400"></i>
                    الدرجة القصوى: <strong>@exam?.MaxScore</strong>
                </span>
            </div>
        </div>
        <a href="@Url.Action("Index")" class="btn btn-neutral">
            <i data-lucide="arrow-right" class="w-4 h-4"></i> عودة للامتحانات
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-2xl p-4 flex items-center gap-3">
            <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-500 flex-shrink-0"></i>
            <span class="font-semibold">@TempData["SuccessMessage"]</span>
        </div>
    }

    <!-- Scores Table -->
    <form asp-action="SaveScores" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="examId" value="@exam?.ExamId" />
        <input type="hidden" name="page" value="@ViewBag.CurrentPage" />
        
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
            <div class="p-6 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                <div>
                    <h3 class="text-lg font-bold text-slate-800">درجات الطلاب</h3>
                    <p class="text-sm text-slate-500">أدخل درجة كل طالب أو اتركها فارغة إذا لم يحضر.</p>
                </div>
                <button type="submit" class="btn btn-primary">
                    <i data-lucide="save" class="w-4 h-4"></i> حفظ الصفحة الحالية
                </button>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-100">
                    <thead class="bg-white">
                        <tr>
                            <th class="px-6 py-4 text-right text-sm font-bold text-slate-500">#</th>
                            <th class="px-6 py-4 text-right text-sm font-bold text-slate-500">اسم الطالب</th>
                            <th class="px-6 py-4 text-center text-sm font-bold text-slate-500">
                                الدرجة <span class="text-slate-400 font-normal">(من @exam?.MaxScore)</span>
                            </th>
                            <th class="px-6 py-4 text-center text-sm font-bold text-slate-500">النسبة</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @{int rowNum = (ViewBag.PaginationInfo.CurrentPage - 1) * 50 + 1;}
                        @foreach (var se in Model)
                        {
                            double? pct = se.Score.HasValue && exam?.MaxScore > 0
                                ? Math.Round((se.Score.Value / exam!.MaxScore) * 100, 1)
                                : null;
                            string pctClass = pct.HasValue
                                ? (pct >= 85 ? "bg-emerald-100 text-emerald-800" : pct >= 50 ? "bg-amber-100 text-amber-800" : "bg-rose-100 text-rose-800")
                                : "bg-slate-100 text-slate-500";

                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="px-6 py-3 text-sm text-slate-400 font-medium">@(rowNum++)</td>
                                <td class="px-6 py-3 font-bold text-slate-800">@se.Student?.FullName</td>
                                <td class="px-6 py-3 text-center">
                                    <input type="number" name="scores[@se.StudentExamId]"
                                           value="@(se.Score.HasValue ? se.Score.Value.ToString() : "")"
                                           min="0" max="@exam?.MaxScore" step="0.5"
                                           class="w-24 text-center px-3 py-1.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all font-bold text-slate-900 score-input"
                                           data-max="@exam?.MaxScore"
                                           placeholder="-"
                                           dir="ltr" />
                                </td>
                                <td class="px-6 py-3 text-center">
                                    <span class="inline-block px-3 py-1 rounded-full text-xs font-bold @pctClass pct-badge" data-studentexam="@se.StudentExamId">
                                        @(pct.HasValue ? $"{pct}%" : "-")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <div class="p-4 border-t border-slate-100 flex justify-end bg-slate-50/50">
                <button type="submit" class="btn btn-primary">
                    <i data-lucide="save" class="w-4 h-4"></i> حفظ الصفحة الحالية
                </button>
            </div>
            
            <partial name="_Pagination" model="ViewBag.PaginationInfo" />
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Live percentage update
        document.querySelectorAll('.score-input').forEach(input => {
            input.addEventListener('input', function() {
                const max = parseFloat(this.dataset.max) || 100;
                const val = parseFloat(this.value);
                const id = this.name.match(/\d+/)?.[0];
                const badge = document.querySelector(`.pct-badge[data-studentexam="${id}"]`);
                if (!badge) return;

                if (isNaN(val) || this.value === '') {
                    badge.textContent = '-';
                    badge.className = 'inline-block px-3 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-500 pct-badge';
                    badge.dataset.studentexam = id;
                    return;
                }

                const pct = Math.round((val / max) * 1000) / 10;
                badge.textContent = pct + '%';
                let cls = pct >= 85 ? 'bg-emerald-100 text-emerald-800' : pct >= 50 ? 'bg-amber-100 text-amber-800' : 'bg-rose-100 text-rose-800';
                badge.className = `inline-block px-3 py-1 rounded-full text-xs font-bold ${cls} pct-badge`;
                badge.dataset.studentexam = id;
            });
        });
    </script>
}
