@{
    ViewData["Title"] = "إعدادات فورم التسجيل";
}

<div class="max-w-3xl mx-auto space-y-8">
    <div class="text-center">
        <h2 class="text-3xl font-extrabold text-slate-800">إدارة نماذج التسجيل</h2>
        <p class="text-slate-500 mt-2">تحكم في فورم تسجيل الطلاب الذاتي ورسائل الترحيب.</p>
    </div>



    <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100">
        <form asp-action="UpdateSettings" method="post" class="space-y-6">
            @Html.AntiForgeryToken()

            <div class="bg-slate-50 rounded-xl p-6 border border-slate-200 space-y-4">
                <div class="flex items-center justify-between border-b border-slate-200 pb-4">
                    <div>
                        <h3 class="text-lg font-bold text-slate-800">حالة الفورم العام</h3>
                        <p class="text-sm text-slate-500 mt-1">إذا تم إيقاف التسجيل، فلن يتمكن أي طالب من إدخال بياناته حتى لو كان يمتلك الرابط.</p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" name="isRegistrationOpen" value="true" class="sr-only peer" @(ViewBag.IsRegistrationOpen ? "checked" : "")>
                        <div class="w-14 h-7 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:-translate-x-7 peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:right-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-6 after:w-6 after:transition-all peer-checked:bg-primary"></div>
                    </label>
                </div>

                <div class="flex items-center justify-between border-b border-slate-200 pb-4">
                    <div>
                        <h3 class="text-md font-bold text-slate-800">إظهار حقل "رقم الهاتف"</h3>
                        <p class="text-sm text-slate-500 mt-1">يُفضل إظهاره إذا كنت تريد استخدام الرقم لاسترجاع الكارنيه لاحقاً.</p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" name="showPhoneNumberField" value="true" class="sr-only peer" @(ViewBag.ShowPhoneNumberField ? "checked" : "")>
                        <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:-translate-x-5 peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:right-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
                    </label>
                </div>

                <div class="flex items-center justify-between border-b border-slate-200 pb-4">
                    <div>
                        <h3 class="text-md font-bold text-slate-800">إظهار حقل "تاريخ الميلاد"</h3>
                        <p class="text-sm text-slate-500 mt-1">إذا تم إخفاؤه، سيقوم الطالب باختيار صفه الدراسي يدوياً بدون تقييد بالسن.</p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" name="showDateOfBirthField" value="true" class="sr-only peer" @(ViewBag.ShowDateOfBirthField ? "checked" : "")>
                        <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:-translate-x-5 peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:right-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
                    </label>
                </div>

                <div class="flex items-center justify-between border-b border-slate-200 pb-4">
                    <div>
                        <h3 class="text-md font-bold text-slate-800">إظهار حقل "السن (يدوي)"</h3>
                        <p class="text-sm text-slate-500 mt-1">إذا تم إظهاره، يمكن للطالب كتابة سنه يدوياً بدلاً من أو مع إدخال تاريخ ميلاده.</p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" name="showAgeField" value="true" class="sr-only peer" @(ViewBag.ShowAgeField ? "checked" : "")>
                        <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:-translate-x-5 peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:right-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
                    </label>
                </div>

                <div class="flex items-center justify-between border-b border-slate-200 pb-4">
                    <div>
                        <h3 class="text-md font-bold text-slate-800">إظهار حقل "الصف / الفرقة"</h3>
                        <p class="text-sm text-slate-500 mt-1">إذا أخفيته، يجب اختيار صف افتراضي يتم تسجيل جميع الطلاب فيه تلقائياً.</p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="showGradeFieldToggle" name="showGradeField" value="true" class="sr-only peer" @(ViewBag.ShowGradeField ? "checked" : "")>
                        <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:-translate-x-5 peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:right-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
                    </label>
                </div>

                <div id="defaultGradeContainer" class="flex items-center justify-between" style="display: @(ViewBag.ShowGradeField ? "none" : "flex")">
                    <div class="w-full">
                        <h3 class="text-md font-bold text-slate-800 mb-2">الصف الافتراضي (لجميع الطلاب الجدد)</h3>
                        <select name="defaultGradeId" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-slate-900 appearance-none bg-white">
                            <option value="">-- اختر الصف الافتراضي --</option>
                            @if (ViewBag.Grades != null)
                            {
                                foreach (var grade in ViewBag.Grades)
                                {
                                    if (ViewBag.DefaultGradeId == grade.GradeId.ToString())
                                    {
                                        <option value="@grade.GradeId" selected>@grade.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@grade.GradeId">@grade.Name</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">رسالة النجاح للطالب</label>
                <p class="text-xs text-slate-500 mb-2">النص الذي سيظهر للطالب أسفل الباركود الخاص به بعد التسجيل بنجاح.</p>
                <textarea name="registrationSuccessMessage" rows="4" class="w-full p-4 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-slate-900" placeholder="مثال: تم تسجيلك بنجاح! احتفظ بهذه الصورة...">@ViewBag.RegistrationSuccessMessage</textarea>
            </div>

            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">رابط جروب الواتس آب (اختياري)</label>
                <p class="text-xs text-slate-500 mb-2">إذا قمت بإضافة رابط هنا، سيتم تحميل كارنيه الطالب تلقائياً ثم تحويله إلى هذا الرابط.</p>
                <div class="relative">
                    <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                        <i data-lucide="link" class="w-5 h-5 text-slate-400"></i>
                    </div>
                    <input type="url" name="whatsappGroupLink" value="@ViewBag.WhatsAppGroupLink" class="w-full pl-4 pr-12 py-3.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-slate-900" placeholder="https://chat.whatsapp.com/..." dir="ltr" />
                </div>
            </div>

            <div class="pt-4 border-t border-slate-100">
                <button type="submit" class="w-full btn btn-primary flex items-center justify-center gap-2">
                    <i data-lucide="save" class="w-5 h-5"></i> حفظ الإعدادات
                </button>
            </div>
        </form>
    </div>

    <div class="bg-blue-50/50 p-6 rounded-2xl border border-blue-100">
        <h3 class="font-bold text-blue-900 mb-2 flex items-center gap-2">
            <i data-lucide="link" class="w-5 h-5 text-blue-500"></i>
            رابط التسجيل للطلاب
        </h3>
        <div class="flex items-center gap-3">
            <input type="text" readonly value="@Url.Action("Register", "Public", new { tenantId = ViewBag.TenantId }, Context.Request.Scheme)" class="flex-grow p-3 rounded-xl border border-blue-200 bg-white text-slate-600 font-mono text-sm" id="publicLink" />
            <button type="button" onclick="copyLink()" class="btn bg-white border border-blue-200 text-blue-600 hover:bg-blue-50 whitespace-nowrap">
                <i data-lucide="copy" class="w-4 h-4 inline-block ml-1"></i> نسخ الرابط
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var showGradeToggle = document.getElementById('showGradeFieldToggle');
            var defaultGradeContainer = document.getElementById('defaultGradeContainer');

            showGradeToggle.addEventListener('change', function () {
                if (this.checked) {
                    defaultGradeContainer.style.display = 'none';
                } else {
                    defaultGradeContainer.style.display = 'flex';
                }
            });
        });

        function copyLink() {
            var copyText = document.getElementById("publicLink");
            copyText.select();
            copyText.setSelectionRange(0, 99999); 
            navigator.clipboard.writeText(copyText.value).then(() => {
                Swal.fire({
                    toast: true,
                    position: 'top',
                    icon: 'success',
                    title: 'تم نسخ الرابط بنجاح!',
                    showConfirmButton: false,
                    timer: 2000,
                    timerProgressBar: true,
                    background: '#f8fafc',
                    color: '#334155',
                    iconColor: '#10b981'
                });
            });
        }
    </script>
}
