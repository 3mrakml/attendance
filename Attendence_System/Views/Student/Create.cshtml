@model Attendence_System.Models.Student

@{
    ViewData["Title"] = "إضافة طالب جديد";
}

<div class="max-w-2xl mx-auto space-y-8">
    <div class="text-center">
        <h2 class="text-3xl font-extrabold text-slate-800">إضافة طالب جديد</h2>
        <p class="text-slate-500 mt-2">قم بتسجيل بيانات الطالب لتوليد رمز الـ QR الخاص به.</p>
    </div>

    <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100">
        <form asp-action="Create" method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="bg-rose-50 text-rose-500 p-4 rounded-xl text-sm mb-4 font-semibold"></div>
            
            <div>
                <label asp-for="FullName" class="block text-sm font-semibold text-slate-700 mb-2">الاسم بالكامل</label>
                <div class="relative">
                    <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                        <i data-lucide="user" class="w-4 h-4 text-slate-400"></i>
                    </div>
                    <input asp-for="FullName" class="w-full pr-10 pl-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-slate-900" required placeholder="مثال: أحمد محمد علي" />
                </div>
                <span asp-validation-for="FullName" class="text-rose-500 text-sm mt-1 block font-medium"></span>
            </div>
            

            
            <div>
                <label asp-for="Age" class="block text-sm font-semibold text-slate-700 mb-2">السن</label>
                <div class="relative">
                    <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                        <i data-lucide="calendar" class="w-4 h-4 text-slate-400"></i>
                    </div>
                    <input asp-for="Age" type="number" min="1" max="120" class="w-full pr-10 pl-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-slate-900 text-left" dir="ltr" required placeholder="مثال: 20" />
                </div>
                <span asp-validation-for="Age" class="text-rose-500 text-sm mt-1 block font-medium"></span>
            </div>

            <div>
                <label asp-for="GradeId" class="block text-sm font-semibold text-slate-700 mb-2">الصف / الفرقة</label>
                <div class="relative">
                    <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                        <i data-lucide="graduation-cap" class="w-4 h-4 text-slate-400"></i>
                    </div>
                    <select asp-for="GradeId" required class="w-full pr-10 pl-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-slate-900 appearance-none bg-white">
                        <option value="">-- اختر الصف --</option>
                        @if (ViewBag.Grades != null)
                        {
                            foreach (var grade in ViewBag.Grades)
                            {
                                <option value="@grade.GradeId">@grade.Name</option>
                            }
                        }
                    </select>
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400"></i>
                    </div>
                </div>
            </div>

            <div class="pt-6 flex flex-col sm:flex-row gap-4">
                <button type="submit" class="flex-1 btn btn-primary flex items-center justify-center gap-2">
                    <i data-lucide="qr-code" class="w-5 h-5"></i> حفظ وتوليد QR
                </button>
                <a asp-action="Index" class="flex-1 btn btn-neutral">
                    العودة للقائمة
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
