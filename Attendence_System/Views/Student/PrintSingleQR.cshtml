@model Attendence_System.Models.Student
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>طباعة ملصق - @Model.FullName</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            font-family: Arial, sans-serif;
        }

        .card {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
            gap: 0;
            width: 95vw;
            height: 95vh;
            page-break-inside: avoid;
            overflow: hidden;
        }

        /* ─── Code side (QR or Barcode) ─── */
        .code-side {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .qr-image {
            width: 95vh;
            height: 95vh;
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            transform: scale(1.25); /* تكبير لـ 125% لاقتطاع المزيد من الهوامش البيضاء */
        }

        .barcode-image {
            width: 45vw;
            height: 30vh;
            object-fit: contain;
        }

        .info-wrapper {
            width: 30vw;
            height: 95vh;
            display: flex;
            align-items: center;
            justify-content: center; /* نوسط الصندوق الأساسي */
        }

        /* ─── Info side ─── */
        .info-side {
            width: 95vh; /* نفس طول البطاقة (قبل الدوران) */
            height: 30vw; /* نفس عرض الصندوق (قبل الدوران) */
            display: flex;
            flex-direction: column;
            justify-content: flex-end; /* لدفع النص نحو الأسفل (الذي سيصبح اليمين بعد الدوران = جهة الباركود) */
            align-items: flex-start; /* لتبدأ كل النصوص من اليمين (الذي سيصبح الأعلى بعد الدوران) */
            gap: 1.5vh;
            transform: rotate(-90deg);
            white-space: nowrap;
        }

        .info-side > div {
            overflow: hidden;
            text-overflow: ellipsis; /* يضع ثلاث نقاط (...) إذا كان الاسم أطول من المساحة */
            white-space: nowrap;
            max-width: 100%;
        }

        .qr-name {
            font-size: clamp(10px, 4vw, 42px);
            font-weight: 500;
            color: #000;
            line-height: 1.2;
        }

        .qr-token {
            font-size: clamp(10px, 3vw, 32px);
            font-weight: 600;
            color: #000;
            font-family: 'Courier New', monospace;
            letter-spacing: 0.1em;
            direction: ltr;
            text-align: right;
        }

        .qr-grade {
            font-size: clamp(8px, 2.5vw, 24px);
            color: #000;
            font-weight: 500;
        }

        @@media print {
            @@page { margin: 0; size: landscape; }
            body { margin: 0; padding: 0; }
        }
    </style>
</head>
<body onload="window.print(); window.onafterprint = function() { window.close(); }">
    <div class="card">
        <div class="code-side">
            @if (ViewBag.CodeType == "Barcode")
            {
                <img src="@ViewBag.QRCode" class="barcode-image" alt="Barcode" />
            }
            else
            {
                <img src="@ViewBag.QRCode" class="qr-image" alt="QR Code" />
            }
        </div>
        <div class="info-wrapper">
            <div class="info-side">
                <div class="qr-name">@Model.FullName</div>
                <div class="qr-token">@Model.QRToken</div>
                <div class="qr-grade">@Model.Grade?.Name</div>
            </div>
        </div>
    </div>
</body>
</html>
