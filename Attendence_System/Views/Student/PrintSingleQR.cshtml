@model Attendence_System.Models.Student
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>طباعة ملصق - @Model.FullName</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: white;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            font-family: Arial, sans-serif;
        }

        .qr-image {
            /* Make the QR code take up the maximum remaining space */
            max-width: 95vw;
            max-height: 70vh;
            object-fit: contain;
            margin-bottom: -2vh;
        }

        .barcode-image {
            width: 95vw;
            height: 25vh; /* Enough height for barcode bars, but leaves room for large text */
            object-fit: contain;
            margin-bottom: 2vh;
            margin-top: 2vh;
        }

        .qr-text {
            font-size: 6vw;
            font-weight: bold;
            margin-top: 0;
            text-align: center;
            color: #000;
        }
        
        .qr-name {
            font-size: 5vw;
            font-weight: 800;
            text-align: center;
            margin-top: 0;
            color: #000;
        }
        
        .qr-grade {
            font-size: 4vw;
            text-align: center;
            color: #333;
            margin-top: 0.5vh;
        }

        /* 
           This CSS rule resets margins during printing so Chrome doesn't 
           try to add default headers, footers, or margins. 
        */
        @@media print {
            @@page {
                margin: 0;
            }
            body {
                margin: 0;
                padding: 0;
            }
        }
    </style>
</head>
<body onload="window.print(); window.onafterprint = function() { window.close(); }">
    @if (ViewBag.CodeType == "Barcode")
    {
        <img src="@ViewBag.QRCode" class="barcode-image" alt="Barcode" />
    }
    else
    {
        <img src="@ViewBag.QRCode" class="qr-image" alt="QR Code" />
    }
    <div class="qr-name">@Model.FullName</div>
    <div class="qr-text">@Model.QRToken</div>
    <div class="qr-grade">@Model.Grade?.Name</div>
</body>
</html>
