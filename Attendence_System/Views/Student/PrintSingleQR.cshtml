@model Attendence_System.Models.Student
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>طباعة ملصق - @Model.FullName</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            font-family: Arial, sans-serif;
        }

        .card {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
            gap: 5vw;
            width: 95vw;
            height: 90vh;
        }

        /* ─── Code side (QR or Barcode) ─── */
        .code-side {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .qr-image {
            width: 90vw;
            height: 90vw;
            max-width: 85vh;
            max-height: 85vh;
            object-fit: contain;
        }

        .barcode-image {
            width: 45vw;
            height: 30vh;
            object-fit: contain;
        }

        /* ─── Info side ─── */
        .info-side {
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 1.5vh;
            transform: rotate(-90deg);
            transform-origin: center center;
            /* compensate so rotated block doesn't overflow */
            white-space: nowrap;
        }

        .qr-name {
            font-size: clamp(12px, 5vw, 52px);
            font-weight: 500;
            color: #000;
            line-height: 1.2;
        }

        .qr-token {
            font-size: clamp(12px, 4vw, 40px);
            font-weight: 600;
            color: #000;
            font-family: 'Courier New', monospace;
            letter-spacing: 0.1em;
            direction: ltr;
            text-align: right;
        }

        .qr-grade {
            font-size: clamp(10px, 3vw, 32px);
            color: #000;
            font-weight: 500;
        }

        @@media print {
            @@page { margin: 0; size: landscape; }
            body { margin: 0; padding: 0; }
        }
    </style>
</head>
<body onload="window.print(); window.onafterprint = function() { window.close(); }">
    <div class="card">
        <div class="code-side">
            @if (ViewBag.CodeType == "Barcode")
            {
                <img src="@ViewBag.QRCode" class="barcode-image" alt="Barcode" />
            }
            else
            {
                <img src="@ViewBag.QRCode" class="qr-image" alt="QR Code" />
            }
        </div>
        <div class="info-side">
            <div class="qr-name">@Model.FullName</div>
            <div class="qr-token">@Model.QRToken</div>
            <div class="qr-grade">@Model.Grade?.Name</div>
        </div>
    </div>
</body>
</html>
