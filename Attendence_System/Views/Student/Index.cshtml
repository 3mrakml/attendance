@model IEnumerable<Attendence_System.Models.Student>

@{
    ViewData["Title"] = "إدارة الطلاب";
}

<div class="space-y-8">
    <div class="flex flex-col md:flex-row md:justify-between md:items-center bg-white p-4 sm:p-6 rounded-2xl shadow-sm border border-slate-100">
        <div class="mb-4 md:mb-0">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-800">قائمة الطلاب</h2>
            <p class="text-slate-500 mt-1 text-sm sm:text-base">إدارة سجلات الطلاب ورموز QR الخاصة بهم.</p>
        </div>
        <div class="mt-2 md:mt-0 flex flex-wrap gap-3">
            <button type="button" onclick="document.getElementById('importStudentModal').classList.remove('hidden')" class="btn btn-neutral">
                <i data-lucide="file-up" class="w-4 h-4"></i> استيراد من Excel
            </button>
            <a href="@Url.Action("PrintAllCards", "Student")" target="_blank" class="btn btn-neutral">
                <i data-lucide="id-card" class="w-4 h-4"></i> طباعة كل الكروت
            </a>
            <a href="@Url.Action("ExportQRCodes", "Student")" target="_blank" class="btn btn-neutral">
                <i data-lucide="qr-code" class="w-4 h-4"></i> تصدير QR Codes
            </a>
            <button type="button" onclick="document.getElementById('addStudentModal').classList.remove('hidden')" class="btn btn-primary">
                <i data-lucide="user-plus" class="w-4 h-4"></i> إضافة طالب جديد
            </button>
        </div>
    </div>

    @* ── نتيجة الاستيراد ── *@
    @if (TempData["ImportError"] != null)
    {
        <div class="bg-rose-50 border border-rose-200 text-rose-800 rounded-2xl p-4 flex items-start gap-3">
            <i data-lucide="circle-x" class="w-5 h-5 mt-0.5 flex-shrink-0 text-rose-500"></i>
            <span class="font-semibold">@TempData["ImportError"]</span>
        </div>
    }
    @if (TempData["ImportAdded"] != null)
    {
        var added = (int)TempData["ImportAdded"]!;
        var errorsJson = TempData["ImportErrors"] as string;
        List<System.Text.Json.JsonElement> errors;
        if (string.IsNullOrEmpty(errorsJson))
            errors = new List<System.Text.Json.JsonElement>();
        else
            errors = System.Text.Json.JsonSerializer.Deserialize<List<System.Text.Json.JsonElement>>(errorsJson)!;

        <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-4 space-y-3">
            <div class="flex items-center gap-3">
                <i data-lucide="circle-check" class="w-5 h-5 text-emerald-600 flex-shrink-0"></i>
                <span class="font-bold text-emerald-800">تم إضافة @added طالب بنجاح.</span>
            </div>
            @if (errors.Any())
            {
                <div class="border-t border-emerald-200 pt-3">
                    <p class="font-semibold text-amber-700 flex items-center gap-2 mb-2">
                        <i data-lucide="triangle-alert" class="w-4 h-4"></i>
                        تم تخطي @errors.Count طالب:
                    </p>
                    <ul class="space-y-1 text-sm">
                        @foreach (var err in errors)
                        {
                            <li class="flex items-center gap-2 text-slate-700">
                                <span class="w-1.5 h-1.5 rounded-full bg-amber-400 flex-shrink-0"></span>
                                <span class="font-semibold">@err.GetProperty("Label").GetString()</span>
                                <span class="text-slate-400">—</span>
                                <span>@err.GetProperty("Reason").GetString()</span>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    }

    <!-- Filters Section -->
    <form id="filterForm" method="get" asp-action="Index" class="bg-white p-4 rounded-2xl shadow-sm border border-slate-100 flex flex-col sm:flex-row gap-4">
        <div class="flex-1 relative">
            <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                <i data-lucide="search" class="w-4 h-4 text-slate-400"></i>
            </div>
            <input type="text" id="searchInput" name="searchString" value="@ViewBag.SearchString" class="w-full pr-10 pl-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-slate-900" placeholder="البحث بالاسم، المعرف أو الموبايل..." />
        </div>
        <div class="sm:w-64 relative">
            <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                <i data-lucide="funnel" class="w-4 h-4 text-slate-400"></i>
            </div>
            <select id="gradeFilter" name="gradeId" class="w-full pr-10 pl-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-slate-900 appearance-none bg-white">
                <option value="">كل الصفوف</option>
                @if (ViewBag.Grades != null)
                {
                    foreach (var grade in ViewBag.Grades)
                    {
                        if (ViewBag.GradeId != null && ViewBag.GradeId == grade.GradeId)
                        {
                            <option value="@grade.GradeId" selected>@grade.Name</option>
                        }
                        else
                        {
                            <option value="@grade.GradeId">@grade.Name</option>
                        }
                    }
                }
            </select>
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400"></i>
            </div>
        </div>
        <input type="hidden" name="page" value="1" id="pageInput" />
    </form>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-100">
                <thead class="bg-slate-50/50">
                    <tr>
                        <th scope="col" class="px-6 py-4 text-right text-sm font-bold text-slate-500 uppercase tracking-wider">#</th>
                        <th scope="col" class="px-6 py-4 text-right text-sm font-bold text-slate-500 uppercase tracking-wider">الاسم بالكامل</th>
                        <th scope="col" class="px-6 py-4 text-right text-sm font-bold text-slate-500 uppercase tracking-wider">الفرقة/الصف</th>
                        <th scope="col" class="px-6 py-4 text-center text-sm font-bold text-slate-500 uppercase tracking-wider">نسبة الحضور</th>
                        <th scope="col" class="px-6 py-4 text-center text-sm font-bold text-slate-500 uppercase tracking-wider">كود الطالب</th>
                        <th scope="col" class="px-6 py-4 text-center text-sm font-bold text-slate-500 uppercase tracking-wider">إجراءات</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-slate-100">
                    @if (Model != null && Model.Any())
                    {
                        int currentIndex = ((ViewBag.CurrentPage ?? 1) - 1) * 50 + 1;
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors group js-delete-parent">
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500 font-medium">@(currentIndex++)</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <a asp-action="Report" asp-route-id="@item.StudentId" class="flex items-center hover:bg-slate-50 p-2 -ml-2 rounded-xl transition-colors group/link cursor-pointer">
                                        <div class="flex-shrink-0 h-10 w-10 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold group-hover/link:bg-primary group-hover/link:text-white transition-colors">
                                            @item.FullName?.FirstOrDefault()
                                        </div>
                                        <div class="mr-4">
                                            <div class="text-sm font-bold text-slate-900 group-hover/link:text-primary transition-colors">@item.FullName</div>
                                        </div>
                                    </a>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @if (item.Grade != null)
                                    {
                                        <span class="px-3 py-1 inline-flex text-xs leading-5 font-bold rounded-full bg-amber-100 text-amber-800">
                                            @item.Grade.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400 text-sm font-medium">غير محدد</span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    @{
                                        double percentage = ViewBag.AttendancePercentages != null && ViewBag.AttendancePercentages.ContainsKey(item.StudentId) 
                                            ? ViewBag.AttendancePercentages[item.StudentId] 
                                            : 0;
                                        
                                        string badgeClass = percentage >= 85 ? "bg-emerald-100 text-emerald-800 border border-emerald-200" 
                                                          : percentage >= 50 ? "bg-amber-100 text-amber-800 border border-amber-200" 
                                                          : "bg-rose-100 text-rose-800 border border-rose-200";
                                    }
                                    <span class="inline-flex items-center px-3 py-1 rounded-xl text-sm font-bold @badgeClass">
                                        @percentage%
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center text-sm font-black text-primary" dir="ltr">
                                    @item.QRToken
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center text-sm font-medium">
                                    <div class="flex items-center justify-center gap-2">
                                        <a href="@Url.Action("DownloadCode", "Student", new { id = item.StudentId })" class="action-btn action-btn-info" title="تحميل رمز QR">
                                            <i data-lucide="download" class="w-4 h-4"></i>
                                        </a>
                                        <a href="@Url.Action("PrintSingleQR", "Student", new { id = item.StudentId })" target="_blank" class="action-btn action-btn-info" title="طباعة ملصق QR (حراري)">
                                            <i data-lucide="printer" class="w-4 h-4"></i>
                                        </a>
                                        <a href="@Url.Action("PrintCard", "Student", new { id = item.StudentId })" target="_blank" class="action-btn action-btn-info" title="طباعة البطاقة (ID)">
                                            <i data-lucide="id-card" class="w-4 h-4"></i>
                                        </a>
                                        <button type="button" class="action-btn action-btn-info js-edit-student"
                                                data-id="@item.StudentId"
                                                data-name="@item.FullName"
                                                data-phone="@item.PhoneNumber"
                                                data-age="@item.Age"
                                                data-dob="@(item.DateOfBirth.HasValue ? item.DateOfBirth.Value.ToString("yyyy-MM-dd") : "")"
                                                data-grade-id="@item.GradeId"
                                                title="تعديل الطالب">
                                            <i data-lucide="pencil" class="w-4 h-4"></i>
                                        </button>
                                        <button class="action-btn action-btn-danger js-delete" data-id="@item.StudentId" data-type="student" title="حذف الطالب">
                                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-16 text-center">
                                <div class="w-20 h-20 bg-slate-50 text-slate-300 rounded-full flex items-center justify-center mx-auto mb-4 text-4xl">
                                    <i data-lucide="users" class="w-8 h-8"></i>
                                </div>
                                <h3 class="text-lg font-bold text-slate-700">لا يوجد طلاب مضافين بعد</h3>
                                <p class="text-slate-500 mt-1 max-w-sm mx-auto">قم بإضافة الطلاب الجدد وسجل بياناتهم الأكاديمية لاستخراج رموز الحضور الخاصة بهم.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="flex items-center justify-between bg-white px-4 py-3 border border-slate-100 rounded-2xl shadow-sm mt-4">
            <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                <div>
                    <p class="text-sm text-slate-700">
                        إجمالي الطلاب <span class="font-bold">@ViewBag.TotalItems</span>
                    </p>
                </div>
                <div>
                    <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination" dir="ltr">
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <a href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, searchString = ViewBag.SearchString, gradeId = ViewBag.GradeId })" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-slate-300 bg-white text-sm font-medium text-slate-500 hover:bg-slate-50">
                                <span class="sr-only">Previous</span>
                                <i data-lucide="chevron-left" class="h-5 w-5"></i>
                            </a>
                        }
                        
                        @{
                            int startPage = Math.Max(1, ViewBag.CurrentPage - 2);
                            int endPage = Math.Min(ViewBag.TotalPages, startPage + 4);
                            if (endPage - startPage < 4) {
                                startPage = Math.Max(1, endPage - 4);
                            }
                        }

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            if (i == ViewBag.CurrentPage)
                            {
                                <span class="relative inline-flex items-center px-4 py-2 border border-primary bg-primary/10 text-sm font-bold text-primary">
                                    @i
                                </span>
                            }
                            else
                            {
                                <a href="@Url.Action("Index", new { page = i, searchString = ViewBag.SearchString, gradeId = ViewBag.GradeId })" class="relative inline-flex items-center px-4 py-2 border border-slate-300 bg-white text-sm font-medium text-slate-700 hover:bg-slate-50">
                                    @i
                                </a>
                            }
                        }

                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <a href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, searchString = ViewBag.SearchString, gradeId = ViewBag.GradeId })" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-slate-300 bg-white text-sm font-medium text-slate-500 hover:bg-slate-50">
                                <span class="sr-only">Next</span>
                                <i data-lucide="chevron-right" class="h-5 w-5"></i>
                            </a>
                        }
                    </nav>
                </div>
            </div>
            
            <div class="flex items-center justify-between w-full sm:hidden">
                @if (ViewBag.CurrentPage > 1)
                {
                    <a href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, searchString = ViewBag.SearchString, gradeId = ViewBag.GradeId })" class="relative inline-flex items-center px-4 py-2 border border-slate-300 text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50">
                        السابق
                    </a>
                }
                else
                {
                    <span class="relative inline-flex items-center px-4 py-2 border border-slate-300 text-sm font-medium rounded-md text-slate-300 bg-slate-50 cursor-not-allowed">
                        السابق
                    </span>
                }
                
                <span class="text-sm font-medium text-slate-700">@ViewBag.CurrentPage / @ViewBag.TotalPages</span>

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, searchString = ViewBag.SearchString, gradeId = ViewBag.GradeId })" class="relative inline-flex items-center px-4 py-2 border border-slate-300 text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50">
                        التالي
                    </a>
                }
                else
                {
                    <span class="relative inline-flex items-center px-4 py-2 border border-slate-300 text-sm font-medium rounded-md text-slate-300 bg-slate-50 cursor-not-allowed">
                        التالي
                    </span>
                }
            </div>
        </div>
    }
</div>

<!-- Edit Student Modal -->
<div id="editStudentModal" class="hidden fixed inset-0 z-50 overflow-y-auto" aria-labelledby="editStudentModalLabel" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:p-0">
        <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm transition-opacity" aria-hidden="true" onclick="document.getElementById('editStudentModal').classList.add('hidden')"></div>

        <div class="relative bg-white rounded-2xl text-right overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:max-w-lg w-full">
            <div class="border-b border-slate-100 p-6 pb-4 flex justify-between items-center">
                <h5 class="text-xl font-bold text-slate-800" id="editStudentModalLabel">تعديل بيانات الطالب</h5>
                <button type="button" class="text-slate-400 hover:text-slate-600 transition-colors" onclick="document.getElementById('editStudentModal').classList.add('hidden')">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
            <form asp-controller="Student" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="EditStudentId" name="StudentId" />
                <div class="p-6 space-y-4">
                    <div>
                        <label for="EditFullName" class="block text-sm font-semibold text-slate-700 mb-2">الاسم بالكامل</label>
                        <input type="text" id="EditFullName" name="FullName" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-slate-900" required />
                    </div>
                    <div>
                        <label for="EditPhoneNumber" class="block text-sm font-semibold text-slate-700 mb-2">رقم الهاتف</label>
                        <input type="text" id="EditPhoneNumber" name="PhoneNumber" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-slate-900" dir="ltr" />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">تاريخ الميلاد</label>
                        <div class="flex gap-2" dir="ltr">
                            <input type="number" id="EditDobDay" placeholder="DD" min="1" max="31" class="w-full px-3 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 text-center" />
                            <span class="flex items-center text-slate-400">/</span>
                            <input type="number" id="EditDobMonth" placeholder="MM" min="1" max="12" class="w-full px-3 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 text-center" />
                            <span class="flex items-center text-slate-400">/</span>
                            <input type="number" id="EditDobYear" placeholder="YYYY" min="1900" max="2100" class="w-full px-3 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 text-center" />
                        </div>
                        <input type="hidden" id="EditDateOfBirth" name="DateOfBirth" />
                        <p id="EditDobError" class="text-xs text-red-500 mt-1 hidden">تاريخ غير صحيح. تأكد من توافق الأيام مع الشهر.</p>
                    </div>
                    <div>
                        <label for="EditAge" class="block text-sm font-semibold text-slate-700 mb-2">السن (يدوي - اختياري)</label>
                        <input type="number" id="EditAge" name="Age" min="0" max="120" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-slate-900 text-left" dir="ltr" />
                    </div>
                    <div>
                        <label for="EditGradeId" class="block text-sm font-semibold text-slate-700 mb-2">الصف / الفرقة</label>
                        <select id="EditGradeId" name="GradeId" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-slate-900 bg-white">
                            <option value="">-- اختر الصف --</option>
                            @if (ViewBag.Grades != null)
                            {
                                foreach (var grade in ViewBag.Grades)
                                {
                                    <option value="@grade.GradeId" data-minage="@grade.MinAge" data-maxage="@grade.MaxAge">@grade.Name</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="border-t border-slate-100 p-6 pt-4 flex gap-3">
                    <button type="button" class="btn btn-neutral flex-1" onclick="document.getElementById('editStudentModal').classList.add('hidden')">إلغاء</button>
                    <button type="submit" class="btn btn-primary flex-1">
                        <i data-lucide="save" class="w-4 h-4"></i> حفظ التعديل
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add Student Modal -->
<div id="addStudentModal" class="hidden fixed inset-0 z-50 overflow-y-auto" aria-labelledby="addStudentModalLabel" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:p-0">
        <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm transition-opacity" aria-hidden="true" onclick="document.getElementById('addStudentModal').classList.add('hidden')"></div>

        <div class="relative bg-white rounded-2xl text-right overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:max-w-lg w-full">
            <div class="border-b border-slate-100 p-6 pb-4 flex justify-between items-center">
                <h5 class="text-xl font-bold text-slate-800" id="addStudentModalLabel">إضافة طالب جديد</h5>
                <button type="button" class="text-slate-400 hover:text-slate-600 transition-colors" onclick="document.getElementById('addStudentModal').classList.add('hidden')">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
            <form asp-controller="Student" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="p-6 space-y-4">
                    <div>
                        <label for="FullName" class="block text-sm font-semibold text-slate-700 mb-2">الاسم بالكامل</label>
                        <input type="text" id="FullName" name="FullName" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-slate-900" required placeholder="مثال: أحمد محمد علي" />
                    </div>
                    <div>
                        <label for="PhoneNumber" class="block text-sm font-semibold text-slate-700 mb-2">رقم الهاتف</label>
                        <input type="text" id="PhoneNumber" name="PhoneNumber" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-slate-900" dir="ltr" placeholder="01xxxxxxxxx" />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">تاريخ الميلاد</label>
                        <div class="flex gap-2" dir="ltr">
                            <input type="number" id="DobDay" placeholder="DD" min="1" max="31" class="w-full px-3 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 text-center" />
                            <span class="flex items-center text-slate-400">/</span>
                            <input type="number" id="DobMonth" placeholder="MM" min="1" max="12" class="w-full px-3 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 text-center" />
                            <span class="flex items-center text-slate-400">/</span>
                            <input type="number" id="DobYear" placeholder="YYYY" min="1900" max="2100" class="w-full px-3 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 text-center" />
                        </div>
                        <input type="hidden" id="DateOfBirth" name="DateOfBirth" />
                        <p id="DobError" class="text-xs text-red-500 mt-1 hidden">تاريخ غير صحيح. تأكد من توافق الأيام مع الشهر.</p>
                    </div>
                    <div>
                        <label for="Age" class="block text-sm font-semibold text-slate-700 mb-2">السن (يدوي - اختياري)</label>
                        <input type="number" id="Age" name="Age" min="0" max="120" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-slate-900 text-left" dir="ltr" placeholder="اتركه فارغاً لو هتدخل تاريخ ميلاد" />
                    </div>
                    <div>
                        <label for="GradeId" class="block text-sm font-semibold text-slate-700 mb-2">الصف / الفرقة</label>
                        <select id="GradeId" name="GradeId" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-slate-900 bg-white">
                            <option value="">-- اختر الصف --</option>
                            @if (ViewBag.Grades != null)
                            {
                                foreach (var grade in ViewBag.Grades)
                                {
                                    <option value="@grade.GradeId" data-minage="@grade.MinAge" data-maxage="@grade.MaxAge">@grade.Name</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="border-t border-slate-100 p-6 pt-4 flex gap-3">
                    <button type="button" class="btn btn-neutral flex-1" onclick="document.getElementById('addStudentModal').classList.add('hidden')">إلغاء</button>
                    <button type="submit" class="btn btn-primary flex-1">
                        <i data-lucide="qr-code" class="w-4 h-4"></i> حفظ وتوليد
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Import from Excel Modal -->
<div id="importStudentModal" class="hidden fixed inset-0 z-50 overflow-y-auto" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:p-0">
        <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm transition-opacity" aria-hidden="true" onclick="document.getElementById('importStudentModal').classList.add('hidden')"></div>

        <div class="relative bg-white rounded-2xl text-right overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:max-w-lg w-full">
            <div class="border-b border-slate-100 p-6 pb-4 flex justify-between items-center">
                <h5 class="text-xl font-bold text-slate-800">استيراد الطلاب من Excel</h5>
                <button type="button" class="text-slate-400 hover:text-slate-600 transition-colors" onclick="document.getElementById('importStudentModal').classList.add('hidden')">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <form asp-controller="Student" asp-action="Import" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="p-6 space-y-5">
                    <!-- تنبيه النموذج -->
                    <div class="bg-blue-50 border border-blue-100 rounded-xl p-4 flex items-start gap-3">
                        <i data-lucide="info" class="w-4 h-4 text-blue-500 flex-shrink-0 mt-0.5"></i>
                        <div class="text-sm text-blue-700">
                            <p class="font-semibold mb-1">قبل الرفع:</p>
                            <p>تأكد أن الملف يحتوي على أعمدة: <strong>الاسم بالكامل</strong> (مطلوب)، السن، رقم الهاتف، الصف.</p>
                            <a href="@Url.Action("ImportTemplate", "Student")" class="inline-flex items-center gap-1 text-blue-600 hover:text-blue-800 font-bold mt-2 underline">
                                <i data-lucide="download" class="w-3.5 h-3.5"></i> تحميل نموذج Excel جاهز
                            </a>
                        </div>
                    </div>

                    <!-- رفع الملف -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">ملف Excel</label>
                        <label for="excelFileInput" class="flex flex-col items-center justify-center w-full h-32 border-2 border-dashed border-slate-300 rounded-xl cursor-pointer bg-slate-50 hover:bg-slate-100 transition-colors">
                            <div class="flex flex-col items-center justify-center">
                                <i data-lucide="file-spreadsheet" class="w-8 h-8 text-slate-400 mb-2"></i>
                                <p class="text-sm text-slate-500"><span class="font-semibold text-primary">اضغط للاختيار</span> أو اسحب الملف هنا</p>
                                <p id="fileNameDisplay" class="text-xs text-slate-400 mt-1">xlsx فقط</p>
                            </div>
                            <input id="excelFileInput" name="excelFile" type="file" class="hidden" accept=".xlsx,.xls" />
                        </label>
                    </div>
                </div>

                <div class="border-t border-slate-100 p-6 pt-4 flex gap-3">
                    <button type="button" class="btn btn-neutral flex-1" onclick="document.getElementById('importStudentModal').classList.add('hidden')">إلغاء</button>
                    <button type="submit" id="importSubmitBtn" class="btn btn-primary flex-1" disabled>
                        <i data-lucide="upload" class="w-4 h-4"></i> رفع واستيراد
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            var typingTimer;                
            var doneTypingInterval = 500;  

            $('#searchInput').on('keyup', function () {
                clearTimeout(typingTimer);
                typingTimer = setTimeout(function() {
                    $('#pageInput').val('1'); 
                    $('#filterForm').submit();
                }, doneTypingInterval);
            });

            $('#searchInput').on('keydown', function () {
                clearTimeout(typingTimer);
            });

            $('#gradeFilter').on('change', function() {
                $('#pageInput').val('1'); 
                $('#filterForm').submit();
            });

            $(document).on('click', '.js-edit-student', function() {
                var btn = $(this);

                $('#EditStudentId').val(btn.attr('data-id'));
                $('#EditFullName').val(btn.attr('data-name'));
                $('#EditPhoneNumber').val(btn.attr('data-phone'));
                $('#EditAge').val(btn.attr('data-age'));
                
                var dobStr = btn.attr('data-dob');
                $('#EditDateOfBirth').val(dobStr);
                $('#EditDobError').addClass('hidden');
                if (dobStr) {
                    var parts = dobStr.split('-');
                    if (parts.length === 3) {
                        $('#EditDobYear').val(parts[0]);
                        $('#EditDobMonth').val(parseInt(parts[1], 10));
                        $('#EditDobDay').val(parseInt(parts[2], 10));
                    }
                } else {
                    $('#EditDobYear').val('');
                    $('#EditDobMonth').val('');
                    $('#EditDobDay').val('');
                }

                $('#EditGradeId').val(btn.attr('data-grade-id'));

                document.getElementById('editStudentModal').classList.remove('hidden');
            });

            // Excel file input: show file name + enable submit button
            $('#excelFileInput').on('change', function() {
                var fileName = this.files[0] ? this.files[0].name : 'xlsx فقط';
                $('#fileNameDisplay').text(fileName);
                $('#importSubmitBtn').prop('disabled', this.files.length === 0);
            });

            // التاريخ المرجعي العام من إعدادات النظام
            var globalRefDate = '@(ViewBag.AgeReferenceDate ?? "")';

            function autoSelectGrade(ageVal, gradeId) {
                if (ageVal === '' || isNaN(ageVal) || !gradeId) return;
                var age = parseInt(ageVal);
                var foundMatch = false;

                $(gradeId + ' option').each(function() {
                    if (!$(this).val()) return true; // تخطي الخيار الافتراضي "-- اختر الصف --"

                    var minAttr = $(this).attr('data-minage');
                    var maxAttr = $(this).attr('data-maxage');
                    
                    // إذا كان كلا الحدين فارغين، لا نختار هذا الصف تلقائياً لأن النطاق غير محدد
                    if (!minAttr && !maxAttr) return true;

                    var min = minAttr ? parseInt(minAttr) : 0;
                    var max = maxAttr ? parseInt(maxAttr) : 1000;
                    
                    if (age >= min && age <= max) {
                        $(gradeId).val($(this).val());
                        foundMatch = true;
                        return false; // إنهاء اللوب عند إيجاد تطابق
                    }
                });

                // إذا لم نجد أي صف يطابق هذا السن الجديد، نقوم بتفريغ الاختيار
                if (!foundMatch) {
                    $(gradeId).val('');
                }
            }

            function calcAndSetAge(dobId, ageId, gradeId) {
                var dob = $(dobId).val();
                if (!dob) return;
                var refDate = (globalRefDate && globalRefDate.trim() !== '') ? new Date(globalRefDate) : new Date();
                var birth = new Date(dob);
                var age = refDate.getFullYear() - birth.getFullYear();
                var m = refDate.getMonth() - birth.getMonth();
                if (m < 0 || (m === 0 && refDate.getDate() < birth.getDate())) age--;
                if (age >= 0 && age <= 120) {
                    $(ageId).val(age).prop('readonly', true).addClass('bg-slate-50 text-slate-500 cursor-not-allowed');
                    autoSelectGrade(age, gradeId);
                }
            }

            function validateAndSetDob(prefix, hiddenId, errorId, ageId, gradeId) {
                var d = $('#' + prefix + 'Day').val();
                var m = $('#' + prefix + 'Month').val();
                var y = $('#' + prefix + 'Year').val();
                
                $(errorId).addClass('hidden');
                
                if(d && m && y) {
                    var dateObj = new Date(y, m - 1, d);
                    // التحقق من أن التاريخ حقيقي (وليس مثل 31 فبراير)
                    if(dateObj.getFullYear() == y && dateObj.getMonth() == m - 1 && dateObj.getDate() == d) {
                        var formattedStr = y + '-' + m.toString().padStart(2, '0') + '-' + d.toString().padStart(2, '0');
                        $(hiddenId).val(formattedStr);
                        calcAndSetAge(hiddenId, ageId, gradeId);
                        
                        // إزالة خطأ الفورم إن وجد لتمكين الحفظ
                        $(this).closest('form').find('button[type="submit"]').prop('disabled', false);
                    } else {
                        $(errorId).removeClass('hidden');
                        $(hiddenId).val('');
                        $(ageId).prop('readonly', false).removeClass('bg-slate-50 text-slate-500 cursor-not-allowed');
                        $(this).closest('form').find('button[type="submit"]').prop('disabled', true);
                    }
                } else {
                    $(hiddenId).val('');
                    $(ageId).prop('readonly', false).removeClass('bg-slate-50 text-slate-500 cursor-not-allowed');
                }
            }

            $('#DobDay, #DobMonth, #DobYear').on('change keyup', function() {
                validateAndSetDob.call(this, 'Dob', '#DateOfBirth', '#DobError', '#Age', '#GradeId');
            });

            $('#EditDobDay, #EditDobMonth, #EditDobYear').on('change keyup', function() {
                validateAndSetDob.call(this, 'EditDob', '#EditDateOfBirth', '#EditDobError', '#EditAge', '#EditGradeId');
            });

            $('#Age').on('change keyup', function() {
                autoSelectGrade($(this).val(), '#GradeId');
            });

            $('#EditAge').on('change keyup', function() {
                autoSelectGrade($(this).val(), '#EditGradeId');
            });
        });
    </script>
}
