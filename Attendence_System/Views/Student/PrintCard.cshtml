@model Attendence_System.Models.Student
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>بطاقة الطالب - @Model.FullName</title>
    <!-- Use Tailwind via CDN for standalone printing -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Cairo', 'sans-serif'],
                    },
                    colors: {
                        card: {
                            bg: '#e9eef8',
                            dark: '#34415b',
                            light: '#c9d5f0'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Cairo', sans-serif; }
        @@media print {
            @@page {
                size: 158mm 92mm landscape; /* مقاس الكارنيه بالضبط */
                margin: 0; /* بدون هوامش */
            }
            body {
                background: white !important;
                margin: 0;
                padding: 0;
                display: flex;
                align-items: flex-start;
                justify-content: flex-start;
            }
            .no-print {
                display: none !important;
            }
            .card-container {
                box-shadow: none !important;
                border: none !important;
                margin: 0 !important;
                width: 158mm !important;
                height: 92mm !important;
                page-break-inside: avoid;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
        }
    </style>
    <!-- html-to-image for better RTL/Arabic support -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html-to-image/1.11.11/html-to-image.min.js"></script>
</head>
<body class="bg-gray-100 min-h-screen flex flex-col items-center justify-center p-8">

    <!-- Control buttons -->
    <div class="no-print flex gap-4 mb-8">
        <button onclick="window.print()" class="bg-card-dark hover:bg-opacity-90 text-white font-bold py-3 px-8 rounded-xl shadow-lg transition-colors flex items-center gap-2">
            <i data-lucide="printer" class="w-5 h-5"></i> طباعة الكارنيه
        </button>
        <button onclick="downloadAsImage()" class="bg-card-dark hover:bg-opacity-90 text-white font-bold py-3 px-8 rounded-xl shadow-lg transition-colors flex items-center gap-2">
            <i data-lucide="image" class="w-5 h-5"></i> تحميل كصورة
        </button>
        <button onclick="window.close()" class="bg-white text-gray-700 font-bold py-3 px-8 rounded-xl shadow-sm border border-gray-200 transition-colors">
            إغلاق
        </button>
    </div>

    <script>
        function downloadAsImage() {
            const card = document.querySelector('.card-container');
            
            // Using html-to-image instead of html2canvas to fix Arabic text (RTL) rendering issues
            htmlToImage.toPng(card, { 
                pixelRatio: 2, 
                backgroundColor: '#e9eef8' 
            })
            .then(function (dataUrl) {
                const link = document.createElement('a');
                link.download = '@Html.Raw(Model.FullName.Replace(" ", "_"))_@(Model.QRToken).png';
                link.href = dataUrl;
                link.click();
            })
            .catch(function (error) {
                console.error('Oops, something went wrong!', error);
                alert("حدث خطأ أثناء استخراج الصورة.");
            });
        }
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
        });
    </script>

    <!-- Card Layout (Landscape 600x350) -->
    <div class="card-container relative w-[600px] h-[350px] bg-card-bg overflow-hidden shadow-2xl rounded-sm flex items-center">
        
        <!-- Top Right Decor (since RTL) -->
        <div class="absolute top-0 right-0 w-24 h-24 bg-card-light rounded-bl-full opacity-80"></div>
        <!-- Circle rings top right -->
        <div class="absolute -top-16 -right-16 w-48 h-48 border-[6px] border-card-dark rounded-full opacity-30"></div>
        <div class="absolute -top-8 -right-8 w-32 h-32 border-[3px] border-card-dark rounded-full opacity-50"></div>
        <!-- Dark accent top right -->
        <div class="absolute top-12 -right-8 w-16 h-24 bg-card-dark rounded-full"></div>

        <!-- Bottom Left Decor (since RTL) -->
        <div class="absolute bottom-0 left-0 w-32 h-32 bg-card-light rounded-tr-full opacity-90"></div>
        <div class="absolute bottom-0 left-0 w-20 h-20 bg-card-dark rounded-tr-full"></div>
        <!-- Circle rings bottom left -->
        <div class="absolute -bottom-20 -left-20 w-64 h-64 border-[4px] border-card-dark rounded-full opacity-80"></div>
        <div class="absolute -bottom-10 -left-10 w-44 h-44 border-[2px] border-card-dark rounded-full opacity-60"></div>
        <div class="absolute -bottom-4 -left-4 w-28 h-28 border-[2px] border-card-dark rounded-full opacity-40"></div>

        <!-- Content -->
        <div class="relative z-10 w-full px-12 flex flex-row items-center justify-between">
            
            <!-- Student Details -->
            <div class="flex-1 text-right pl-8">
                <h1 class="text-4xl font-extrabold text-card-dark tracking-tight mb-4" style="font-family: 'Arial', sans-serif;">@Model.FullName</h1>
                
                <div class="w-full h-[2px] bg-card-dark opacity-30 mb-6"></div>
                
                <div class="space-y-4 text-card-dark font-medium text-sm">
                    <div class="flex items-center gap-3">
                        <div class="w-7 h-7 rounded-full bg-card-dark text-white flex items-center justify-center text-sm shadow-md"><i data-lucide="scan-barcode" class="w-3.5 h-3.5"></i></div>
                        <span class="text-base">الرقم التعريفي: <span class="font-bold font-mono tracking-widest bg-white/50 px-2 py-0.5 rounded ml-1">@Model.QRToken</span></span>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="w-7 h-7 rounded-full bg-card-dark text-white flex items-center justify-center text-sm shadow-md"><i data-lucide="calendar" class="w-3.5 h-3.5"></i></div>
                        <span class="text-base">السن: <span class="font-bold font-mono text-lg ml-1">@Model.Age</span></span>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="w-7 h-7 rounded-full bg-card-dark text-white flex items-center justify-center text-sm shadow-md"><i data-lucide="graduation-cap" class="w-3.5 h-3.5"></i></div>
                        <span class="text-base">الصف: <span class="font-bold ml-1">@(Model.Grade?.Name ?? "غير محدد")</span></span>
                    </div>
                </div>
            </div>
            
            <!-- QR Code on the Left -->
            <div class="bg-white p-4 rounded-2xl shadow-xl border-4 border-white transform rotate-2 hover:rotate-0 transition-transform">
                <img src="@ViewBag.QRCode" class="w-40 h-40 object-contain mix-blend-multiply" alt="QR Code" />
            </div>

        </div>
    </div>
</body>
</html>
