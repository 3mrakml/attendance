@model Attendence_System.ViewModel.StudentReportViewModel

@{
    ViewData["Title"] = $"إحصائيات الطالب - {Model.Student.FullName}";
}

<div class="space-y-6">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center bg-white p-6 rounded-2xl shadow-sm border border-slate-100 gap-4">
        <div class="flex items-center gap-4">
            <div class="w-16 h-16 rounded-full bg-primary-light text-primary flex items-center justify-center text-2xl font-extrabold shadow-inner border border-slate-200">
                @Model.Student.FullName.FirstOrDefault()
            </div>
            <div>
                <h2 class="text-2xl font-bold text-slate-800">@Model.Student.FullName</h2>
                <div class="flex flex-wrap items-center gap-3 mt-1 text-sm text-slate-500 font-medium">
                    <span><i data-lucide="graduation-cap" class="w-4 h-4 inline-block mr-1"></i> @(Model.Student.Grade?.Name ?? "بدون صف")</span>
                    <span class="hidden sm:inline-block w-1 h-1 rounded-full bg-slate-300"></span>
                    <span><i data-lucide="scan-barcode" class="w-4 h-4 inline-block mr-1"></i> @Model.Student.QRToken</span>
                    <span class="hidden sm:inline-block w-1 h-1 rounded-full bg-slate-300"></span>
                    <span><i data-lucide="phone" class="w-4 h-4 inline-block mr-1"></i> @(string.IsNullOrEmpty(Model.Student.PhoneNumber) ? "غير مسجل" : Model.Student.PhoneNumber)</span>
                    <span class="hidden sm:inline-block w-1 h-1 rounded-full bg-slate-300"></span>
                    <span title="تاريخ الميلاد"><i data-lucide="cake" class="w-4 h-4 inline-block mr-1"></i> @(Model.Student.DateOfBirth.HasValue ? Model.Student.DateOfBirth.Value.ToString("yyyy-MM-dd") : "غير مسجل")</span>
                    <span class="hidden sm:inline-block w-1 h-1 rounded-full bg-slate-300"></span>
                    <span><i data-lucide="user" class="w-4 h-4 inline-block mr-1"></i> @Model.Student.Age سنة</span>
                </div>
            </div>
        </div>
        <div class="flex gap-2 w-full md:w-auto">
            <a asp-action="PrintCard" asp-route-id="@Hashids.Encode(Model.Student.StudentId)" target="_blank" class="flex-1 md:flex-none btn btn-neutral">
                <i data-lucide="id-card" class="w-4 h-4 mr-1"></i> الكارنيه
            </a>
            <a asp-action="Index" class="flex-1 md:flex-none btn btn-neutral">
                <i data-lucide="arrow-right" class="w-4 h-4 mr-1"></i> عودة
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Total -->
        <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-100 flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-slate-50 text-slate-500 flex items-center justify-center text-xl">
                <i data-lucide="layers" class="w-6 h-6"></i>
            </div>
            <div>
                <p class="text-sm font-semibold text-slate-500">إجمالي المحاضرات</p>
                <p class="text-2xl font-black text-slate-800">@Model.TotalLectures</p>
            </div>
        </div>

        <!-- Attended -->
        <div class="bg-white p-5 rounded-2xl shadow-sm border border-emerald-100 flex items-center gap-4 relative overflow-hidden">
            <div class="absolute -left-4 -bottom-4 opacity-5 text-emerald-600"><i data-lucide="check-circle-2" class="w-24 h-24"></i></div>
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl relative z-10">
                <i data-lucide="check" class="w-6 h-6"></i>
            </div>
            <div class="relative z-10">
                <p class="text-sm font-semibold text-emerald-700">مرات الحضور</p>
                <p class="text-2xl font-black text-emerald-900">@Model.AttendedCount</p>
            </div>
        </div>

        <!-- Absent -->
        <div class="bg-white p-5 rounded-2xl shadow-sm border border-rose-100 flex items-center gap-4 relative overflow-hidden">
            <div class="absolute -left-4 -bottom-4 opacity-5 text-rose-600"><i data-lucide="x-circle" class="w-24 h-24"></i></div>
            <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl relative z-10">
                <i data-lucide="x" class="w-6 h-6"></i>
            </div>
            <div class="relative z-10">
                <p class="text-sm font-semibold text-rose-700">مرات الغياب</p>
                <p class="text-2xl font-black text-rose-900">@Model.AbsentCount</p>
            </div>
        </div>

        <!-- Percentage -->
        <div class="bg-primary p-5 rounded-2xl shadow-lg border border-white/10 flex items-center gap-4 text-white relative overflow-hidden">
            <div class="absolute -right-4 -top-4 opacity-10 text-white"><i data-lucide="percent" class="w-24 h-24"></i></div>
            <div class="w-12 h-12 rounded-xl bg-white/20 backdrop-blur-sm flex items-center justify-center text-xl relative z-10">
                <i data-lucide="pie-chart" class="w-6 h-6"></i>
            </div>
            <div class="relative z-10">
                <p class="text-sm font-medium text-slate-300">نسبة الحضور</p>
                <p class="text-2xl font-black">@Model.AttendancePercentage%</p>
            </div>
        </div>
    </div>

    <!-- Lectures List -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
            <div>
                <h3 class="text-lg font-bold text-slate-800">السجل التفصيلي للمحاضرات</h3>
                <p class="text-sm text-slate-500">تفاصيل الحضور والغياب لجميع محاضرات الصف.</p>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-100">
                <thead class="bg-white">
                    <tr>
                        <th class="px-6 py-4 text-right text-sm font-bold text-slate-500">تاريخ المحاضرة</th>
                        <th class="px-6 py-4 text-right text-sm font-bold text-slate-500">اسم المحاضرة</th>
                        <th class="px-6 py-4 text-right text-sm font-bold text-slate-500">المادة</th>
                        <th class="px-6 py-4 text-center text-sm font-bold text-slate-500">الحالة</th>
                        <th class="px-6 py-4 text-right text-sm font-bold text-slate-500">وقت تسجيل الحضور</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50 bg-slate-50/20">
                    @if (Model.LecturesDetails.Any())
                    {
                        foreach (var lec in Model.LecturesDetails)
                        {
                            <tr class="hover:bg-white transition-colors">
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-slate-700">
                                    <div class="flex items-center gap-2">
                                        <i data-lucide="calendar" class="w-4 h-4 text-slate-400"></i>
                                        @lec.LectureDate.ToString("yyyy-MM-dd")
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-slate-800">
                                    @lec.LectureTitle
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-500">
                                    @lec.CourseName
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    @if (lec.IsAttended)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700 border border-emerald-200 shadow-sm">
                                            <i data-lucide="check-circle-2" class="w-3.5 h-3.5"></i> حضر
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-rose-100 text-rose-700 border border-rose-200 shadow-sm">
                                            <i data-lucide="x-circle" class="w-3.5 h-3.5"></i> غائب
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500 font-medium">
                                    @if (lec.IsAttended && lec.AttendedAt.HasValue)
                                    {
                                        <span dir="ltr" class="inline-block">@lec.AttendedAt.Value.ToString("hh:mm tt")</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-300">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center text-slate-500">
                                <div class="text-slate-300 mb-3 flex justify-center"><i data-lucide="inbox" class="w-12 h-12"></i></div>
                                لا توجد محاضرات مسجلة لهذا الصف حتى الآن.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
