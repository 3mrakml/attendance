@model IEnumerable<Attendence_System.Models.Student>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>تصدير أكواد الطلاب (حراري)</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: white;
            font-family: Arial, sans-serif;
        }

        .no-print {
            text-align: center;
            padding: 20px;
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            margin-bottom: 20px;
        }

        .no-print button {
            background-color: #4f46e5;
            color: white;
            border: none;
            padding: 10px 20px;
            font-size: 16px;
            border-radius: 8px;
            cursor: pointer;
            margin: 0 10px;
        }

        .no-print button.close-btn {
            background-color: #fff;
            color: #333;
            border: 1px solid #ccc;
        }

        /* ─── One page per student ─── */
        .print-page {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
            gap: 5vw;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            page-break-after: always;
            break-after: page;
        }

        /* ─── Code side ─── */
        .code-side {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .qr-image {
            width: 90vw;
            height: 90vw;
            max-width: 85vh;
            max-height: 85vh;
            object-fit: contain;
        }

        .barcode-image {
            width: 45vw;
            height: 30vh;
            object-fit: contain;
        }

        /* ─── Info side ─── */
        .info-side {
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 1.5vh;
            transform: rotate(-90deg);
            transform-origin: center center;
            white-space: nowrap;
        }

        .qr-name {
            font-size: clamp(12PX, 5vw, 52px);
            font-weight: 500;
            color: #000;
            line-height: 1.2;
        }

        .qr-token {
            font-size: clamp(12px, 4vw, 40px);
            font-weight: 600;
            color: #000;
            font-family: 'Courier New', monospace;
            letter-spacing: 0.1em;
            direction: ltr;
            text-align: right;
        }

        .qr-grade {
            font-size: clamp(10px, 3vw, 32px);
            color: #000;
            font-weight: 500;
        }

        @@media print {
            @@page { margin: 0; size: landscape; }
            body { margin: 0; padding: 0; }
            .no-print { display: none !important; }
            .print-page {
                height: 100vh !important;
                width: 100vw !important;
            }
        }
    </style>
</head>
<body>

    <!-- Toolbar (screen only) -->
    <div class="no-print">
        <h2>🎓 تجهيز أكواد @Model.Count() طالب للطباعة الحرارية</h2>
        <button onclick="window.print()">🖨️ بدء الطباعة</button>
        <button class="close-btn" onclick="window.close()">إغلاق</button>
    </div>

    @foreach (var student in Model)
    {
        var qrCode = ViewBag.StudentQRCodes != null && ((IDictionary<int, string>)ViewBag.StudentQRCodes).ContainsKey(student.StudentId)
            ? ViewBag.StudentQRCodes[student.StudentId]
            : "";

        <div class="print-page">
            @if (!string.IsNullOrEmpty(qrCode))
            {
                <div class="code-side">
                    @if (ViewBag.CodeType == "Barcode")
                    {
                        <img src="@qrCode" class="barcode-image" alt="Barcode" />
                    }
                    else
                    {
                        <img src="@qrCode" class="qr-image" alt="QR Code" />
                    }
                </div>
            }
            <div class="info-side">
                <div class="qr-name">@student.FullName</div>
                <div class="qr-token">@student.QRToken</div>
                <div class="qr-grade">@student.Grade?.Name</div>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div style="text-align:center; margin-top: 50px;">لا يوجد طلاب لطباعة الرموز الخاصة بهم.</div>
    }

</body>
</html>
