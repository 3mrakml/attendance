@model IEnumerable<Attendence_System.Models.Student>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>تصدير أكواد الطلاب (حراري)</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: white;
            font-family: Arial, sans-serif;
        }

        .no-print {
            text-align: center;
            padding: 20px;
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            margin-bottom: 20px;
        }

        .no-print button {
            background-color: #4f46e5;
            color: white;
            border: none;
            padding: 10px 20px;
            font-size: 16px;
            border-radius: 8px;
            cursor: pointer;
            margin: 0 10px;
        }

        .no-print button.close-btn {
            background-color: #fff;
            color: #333;
            border: 1px solid #ccc;
        }

        /* ─── One page per student ─── */
        .print-page {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
            gap: 0;
            width: 100vw;
            height: 98vh; /* تجنب كسر الصفحة بسبب ارتفاع 100vh بالضبط */
            overflow: hidden;
            page-break-after: always;
            break-after: page;
            page-break-inside: avoid;
        }

        .print-page:last-of-type {
            page-break-after: auto;
            break-after: auto;
        }

        /* ─── Code side ─── */
        .code-side {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .qr-image {
            width: 95vh;
            height: 95vh;
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            transform: scale(1.25); /* تكبير لـ 125% لاقتطاع المزيد من الهوامش البيضاء */
        }

        .barcode-image {
            width: 45vw;
            height: 30vh;
            object-fit: contain;
        }

        .info-wrapper {
            width: 30vw;
            height: 98vh;
            display: flex;
            align-items: center;
            justify-content: center; /* نوسط الصندوق الأساسي */
        }

        /* ─── Info side ─── */
        .info-side {
            width: 98vh; /* نفس طول الصفحة */
            height: 30vw; /* نفس عرض الصندوق */
            display: flex;
            flex-direction: column;
            justify-content: flex-end; /* لدفع النص للباركود */
            align-items: flex-start; /* لتثبيت البداية من الأعلى */
            gap: 1.5vh;
            transform: rotate(-90deg);
            white-space: nowrap;
        }

        .info-side > div {
            overflow: hidden;
            text-overflow: ellipsis; /* يضع ثلاث نقاط (...) إذا كان الاسم أطول من المساحة */
            white-space: nowrap;
            max-width: 100%;
        }

        .qr-name {
            font-size: clamp(10px, 4vw, 42px);
            font-weight: 500;
            color: #000;
            line-height: 1.2;
        }

        .qr-token {
            font-size: clamp(10px, 3vw, 32px);
            font-weight: 600;
            color: #000;
            font-family: 'Courier New', monospace;
            letter-spacing: 0.1em;
            direction: ltr;
            text-align: right;
        }

        .qr-grade {
            font-size: clamp(8px, 2.5vw, 24px);
            color: #000;
            font-weight: 500;
        }

        @@media print {
            @@page { margin: 0; size: landscape; }
            body { margin: 0; padding: 0; }
            .no-print { display: none !important; }
            .print-page {
                height: 100vh !important;
                width: 100vw !important;
            }
        }
    </style>
</head>
<body>

    <!-- Toolbar (screen only) -->
    <div class="no-print">
        <h2>🎓 تجهيز أكواد @Model.Count() طالب للطباعة الحرارية</h2>
        <button onclick="window.print()">🖨️ بدء الطباعة</button>
        <button class="close-btn" onclick="window.close()">إغلاق</button>
    </div>

    @foreach (var student in Model)
    {
        <div class="print-page">
            <div class="code-side">
                @if (ViewBag.CodeType == "Barcode")
                {
                    <img src="@Url.Action("DownloadCode", "Student", new { id = Hashids.Encode(student.StudentId) })" class="barcode-image" alt="Barcode" />
                }
                else
                {
                    <div class="qr-container">
                        <img src="@Url.Action("DownloadCode", "Student", new { id = Hashids.Encode(student.StudentId) })" class="qr-image" alt="QR Code" />
                    </div>
                }
            </div>
            <div class="info-wrapper">
                <div class="info-side">
                    <div class="qr-name">@student.FullName</div>
                    <div class="qr-token">@student.QRToken</div>
                    <div class="qr-grade">@student.Grade?.Name</div>
                </div>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div style="text-align:center; margin-top: 50px;">لا يوجد طلاب لطباعة الرموز الخاصة بهم.</div>
    }

</body>
</html>
