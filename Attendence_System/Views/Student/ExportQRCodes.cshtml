@model IEnumerable<Attendence_System.Models.Student>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>تصدير أكواد الطلاب (حراري)</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: white;
            font-family: Arial, sans-serif;
        }

        .no-print {
            text-align: center;
            padding: 20px;
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            margin-bottom: 20px;
        }

        .no-print button {
            background-color: #4f46e5;
            color: white;
            border: none;
            padding: 10px 20px;
            font-size: 16px;
            border-radius: 8px;
            cursor: pointer;
            margin: 0 10px;
        }

        .no-print button.close {
            background-color: #fff;
            color: #333;
            border: 1px solid #ccc;
        }

        .print-page {
            /* For screen display, it just looks like a tall column of cards */
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            page-break-after: always;
            break-after: page;
        }

        .qr-image {
            max-width: 95vw;
            max-height: 70vh;
            object-fit: contain;
            margin-bottom: -2vh;
        }

        .barcode-image {
            width: 95vw;
            height: 25vh;
            object-fit: contain;
            margin-bottom: 2vh;
            margin-top: 2vh;
        }

        .qr-text {
            font-size: 6vw;
            font-weight: bold;
            margin-top: 0;
            text-align: center;
            color: #000;
        }
        
        .qr-name {
            font-size: 5vw;
            font-weight: 800;
            text-align: center;
            margin-top: 0;
            color: #000;
        }
        
        .qr-grade {
            font-size: 4vw;
            text-align: center;
            color: #333;
            margin-top: 0.5vh;
        }

        @@media print {
            @@page {
                margin: 0;
            }
            body {
                margin: 0;
                padding: 0;
            }
            .no-print {
                display: none !important;
            }
            .print-page {
                /* Ensure it takes exactly one page in print */
                height: 100vh !important;
                width: 100vw !important;
            }
        }
    </style>
</head>
<body>

    <!-- Toolbar -->
    <div class="no-print">
        <h2>🎓 تجهيز أكواد @Model.Count() طالب للطباعة الحرارية</h2>
        <button onclick="window.print()">🖨️ بدء الطباعة</button>
        <button class="close" onclick="window.close()">إغلاق</button>
    </div>

    @foreach (var student in Model)
    {
        var qrCode = ViewBag.StudentQRCodes != null && ((IDictionary<int, string>)ViewBag.StudentQRCodes).ContainsKey(student.StudentId)
            ? ViewBag.StudentQRCodes[student.StudentId]
            : "";

        <div class="print-page">
            @if (!string.IsNullOrEmpty(qrCode))
            {
                if (ViewBag.CodeType == "Barcode")
                {
                    <img src="@qrCode" class="barcode-image" alt="Barcode" />
                }
                else
                {
                    <img src="@qrCode" class="qr-image" alt="QR Code" />
                }
            }
            <div class="qr-name">@student.FullName</div>
            <div class="qr-text">@student.QRToken</div>
            <div class="qr-grade">@student.Grade?.Name</div>
        </div>
    }

    @if (!Model.Any())
    {
        <div style="text-align:center; margin-top: 50px;">لا يوجد طلاب لطباعة الرموز الخاصة بهم.</div>
    }

</body>
</html>
