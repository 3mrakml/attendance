@model Attendence_System.ViewModel.RegisterViewModel
@{
    ViewData["Title"] = "إنشاء حساب جديد";
    ViewData["Subtitle"] = "انضم إلى نظام إدارة الحضور وابدأ الآن.";
    ViewData["BrandBadge"] = "انضم إلينا اليوم";
    ViewData["BrandTitle"] = "انضم لمستقبل <br/> <span class=\"text-slate-400\">إدارة الحضور.</span>";
    ViewData["BrandDescription"] = "خطوات بسيطة تفصلك عن امتلاك أقوى أدوات الإدارة الذكية وتتبع حضور الطلاب بفاعلية وسهولة.";
    ViewData["BrandShowFeatures"] = true;
    ViewData["AuthBgImage"] = "~/images/register-bg-dark.png";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<form asp-controller="Auth" asp-action="Register" method="post" class="space-y-4">
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.SelectMany(v => v.Errors).Any())
    {
        <div class="p-4 rounded-xl bg-red-50 border border-red-100 text-red-600 text-sm font-bold flex items-center gap-3">
            <i data-lucide="alert-circle" class="w-5 h-5 flex-shrink-0"></i>
            <div class="flex flex-col">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <span>@error.ErrorMessage</span>
                }
            </div>
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="space-y-1.5">
            <label asp-for="FirstName" class="text-xs font-bold text-slate-500 mr-1">الاسم الأول</label>
            <div class="relative">
                <span class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400">
                    <i data-lucide="user" class="w-4 h-4"></i>
                </span>
                <input asp-for="FirstName" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 pr-10 pl-4 text-slate-800 outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all font-medium text-sm" placeholder="الاسم الأول" />
            </div>
            <span asp-validation-for="FirstName" class="text-red-500 text-[10px] font-bold mr-1 block"></span>
        </div>

        <div class="space-y-1.5">
            <label asp-for="LastName" class="text-xs font-bold text-slate-500 mr-1">الاسم الأخير</label>
            <div class="relative">
                <span class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400">
                    <i data-lucide="user" class="w-4 h-4"></i>
                </span>
                <input asp-for="LastName" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 pr-10 pl-4 text-slate-800 outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all font-medium text-sm" placeholder="الاسم الأخير" />
            </div>
            <span asp-validation-for="LastName" class="text-red-500 text-[10px] font-bold mr-1 block"></span>
        </div>

        <div class="space-y-1.5 md:col-span-2">
            <label asp-for="Email" class="text-xs font-bold text-slate-500 mr-1">البريد الإلكتروني</label>
            <div class="relative">
                <span class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400">
                    <i data-lucide="mail" class="w-4 h-4"></i>
                </span>
                <input asp-for="Email" type="email" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 pr-10 pl-4 text-slate-800 outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all font-medium text-sm" placeholder="name@example.com" dir="ltr" />
            </div>
            <span asp-validation-for="Email" class="text-red-500 text-[10px] font-bold mr-1 block"></span>
        </div>

        <div class="space-y-1.5">
            <label asp-for="Password" class="text-xs font-bold text-slate-500 mr-1">كلمة المرور</label>
            <div class="relative">
                <span class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400">
                    <i data-lucide="lock" class="w-4 h-4"></i>
                </span>
                <input asp-for="Password" type="password" id="passwordInput" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 pr-10 pl-10 text-slate-800 outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all font-medium text-sm" placeholder="••••••••" dir="ltr" />
                <button type="button" class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-800 transition-all toggle-password" data-target="passwordInput">
                    <i data-lucide="eye" class="w-4 h-4 eye-open"></i>
                    <i data-lucide="eye-off" class="w-4 h-4 eye-closed hidden"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-red-500 text-[10px] font-bold mr-1 block"></span>
        </div>

        <div class="space-y-1.5">
            <label asp-for="ConfirmPassword" class="text-xs font-bold text-slate-500 mr-1">تأكيد كلمة المرور</label>
            <div class="relative">
                <span class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400">
                    <i data-lucide="check-circle" class="w-4 h-4"></i>
                </span>
                <input asp-for="ConfirmPassword" type="password" id="confirmPasswordInput" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 pr-10 pl-10 text-slate-800 outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all font-medium text-sm" placeholder="••••••••" dir="ltr" />
                <button type="button" class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-800 transition-all toggle-password" data-target="confirmPasswordInput">
                    <i data-lucide="eye" class="w-4 h-4 eye-open"></i>
                    <i data-lucide="eye-off" class="w-4 h-4 eye-closed hidden"></i>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-red-500 text-[10px] font-bold mr-1 block"></span>
        </div>
    </div>

    <div class="pt-4">
        <button type="submit" id="btn-submit-reg" class="w-full bg-primary text-white py-4 rounded-xl font-black text-lg hover:bg-primary-hover hover:scale-[1.01] active:scale-[0.98] transition-all shadow-xl shadow-primary/20">
            إنشاء حساب جديد
        </button>
    </div>

    <p class="text-center text-slate-500 font-bold text-sm pt-4">
        لديك حساب بالفعل؟
        <a asp-controller="Auth" asp-action="Login" data-direction="right" class="text-slate-800 underline underline-offset-4 hover:text-primary transition-colors auth-switch-link">تسجيل الدخول</a>
    </p>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            $('form').on('submit', function() {
                if ($(this).valid()) {
                    const btn = $('#btn-submit-reg');
                    btn.prop('disabled', true);
                    btn.html('<span class="flex items-center justify-center gap-2"><i data-lucide="loader-2" class="w-5 h-5 animate-spin"></i> جاري إنشاء الحساب...</span>');
                    lucide.createIcons();
                }
            });
        });
    </script>
}
