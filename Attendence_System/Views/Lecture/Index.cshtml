@model IEnumerable<Attendence_System.Models.Lecture>

@{
    ViewData["Title"] = "إدارة المحاضرات";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:justify-between md:items-center bg-white p-4 sm:p-6 rounded-2xl shadow-sm border border-slate-100 gap-4">
        <div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-800">المحاضرات</h2>
            <p class="text-slate-500 mt-1 text-sm sm:text-base">استعرض جميع المحاضرات، قم بفلترتها، أو أدخل سجلات الحضور.</p>

        </div>
        <a href="@Url.Action("Create", "Lecture")" class="btn btn-primary whitespace-nowrap">
            <i data-lucide="plus" class="w-4 h-4"></i> إنشاء محاضرة جديدة
        </a>
    </div>

    <!-- Filters Section -->
    <div class="bg-white p-4 sm:p-6 rounded-2xl shadow-sm border border-slate-100">
        <form id="lectureFilterForm" method="get" asp-action="Index" class="js-auto-filter grid grid-cols-1 md:grid-cols-12 gap-4">
            <div class="md:col-span-6 lg:col-span-7">
                <label class="block text-sm font-bold text-slate-700 mb-2">البحث</label>
                <div class="relative">
                    <span class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400">
                        <i data-lucide="search" class="w-5 h-5"></i>
                    </span>
                    <input type="text" id="lectureSearchInput" name="search" value="@ViewBag.CurrentSearch"
                           class="w-full pl-4 pr-12 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-slate-800"
                           placeholder="ابحث باسم المحاضرة أو المادة..." />
                </div>
            </div>

            <div class="md:col-span-4 lg:col-span-5">
                <label class="block text-sm font-bold text-slate-700 mb-2">تصفية حسب الصف</label>
                <div class="relative">
                    <select id="gradeFilterSelect" name="gradeId" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all appearance-none bg-white text-slate-800 font-medium">
                        <option value="">جميع الصفوف</option>
                        @if (ViewBag.Grades != null)
                        {
                            foreach (var grade in ViewBag.Grades)
                            {
                                if (ViewBag.CurrentGradeId != null && grade.GradeId == ViewBag.CurrentGradeId)
                                {
                                    <option value="@grade.GradeId" selected>@grade.Name</option>
                                }
                                else
                                {
                                    <option value="@grade.GradeId">@grade.Name</option>
                                }
                            }
                        }
                    </select>
                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">
                        <i data-lucide="chevron-down" class="w-4 h-4"></i>
                    </span>
                </div>
            </div>
        </form>
    </div>

    <!-- Lectures Table -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table id="lecturesTable" class="min-w-full divide-y divide-slate-100">
                <thead class="bg-slate-50/50">
                    <tr>
                        <th class="px-6 py-4 text-right text-sm font-bold text-slate-500">عنوان المحاضرة</th>
                        <th class="px-6 py-4 text-right text-sm font-bold text-slate-500">المادة</th>
                        <th class="px-6 py-4 text-right text-sm font-bold text-slate-500">الصفوف</th>
                        <th class="px-6 py-4 text-right text-sm font-bold text-slate-500">التاريخ</th>
                        <th class="px-6 py-4 text-center text-sm font-bold text-slate-500">نسبة الحضور</th>
                        <th class="px-6 py-4 text-center text-sm font-bold text-slate-500">إجراءات</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-slate-100">
                    @if (Model.Any())
                    {
                        foreach (var lecture in Model)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors js-delete-parent"
                                data-search="@($"{lecture.Title} {lecture.Course?.Name}")" >
                                <td class="px-6 py-4 whitespace-nowrap font-bold text-slate-800">
                                    <span>@lecture.Title</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @if (lecture.Course != null)
                                    {
                                        <span class="px-3 py-1 rounded-full bg-indigo-100 text-indigo-800 font-semibold text-xs">@lecture.Course.Name</span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex flex-wrap gap-1">
                                        @if (lecture.LectureGrades != null && lecture.LectureGrades.Any())
                                        {
                                            @foreach (var lg in lecture.LectureGrades)
                                            {
                                                <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 font-semibold text-xs">@lg.Grade?.Name</span>
                                            }
                                        }
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600 font-medium" dir="ltr">
                                    @lecture.DateTime.ToString("yyyy-MM-dd hh:mm tt")
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center" dir="ltr">
                                    @{
                                        int totalStudents = lecture.LectureGrades?.Sum(lg => lg.Grade?.StudentCount ?? 0) ?? 0;
                                        int percentage = totalStudents > 0 ? (int)Math.Round((double)lecture.AttendedCount / totalStudents * 100) : 0;
                                        string colorClass = percentage >= 80 ? "bg-emerald-100 text-emerald-700 border-emerald-200" :
                                                            percentage >= 50 ? "bg-amber-100 text-amber-700 border-amber-200" :
                                                            "bg-rose-100 text-rose-700 border-rose-200";
                                    }
                                    <span class="inline-flex items-center px-3 py-1 rounded-full font-bold text-xs border @colorClass">
                                        @percentage%
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    <div class="flex items-center justify-center gap-2">
                                        <a href="@Url.Action("Students", "Lecture", new { id = Hashids.Encode(lecture.LectureId) })" class="action-btn action-btn-success" title="تفاصيل الحضور">
                                            <i data-lucide="eye" class="w-4 h-4"></i>
                                        </a>
                                        <button type="button" class="action-btn action-btn-primary js-edit-lecture" 
                                                data-id="@lecture.LectureId" 
                                                data-title="@lecture.Title" 
                                                title="تعديل اسم المحاضرة">
                                            <i data-lucide="pencil" class="w-4 h-4"></i>
                                        </button>
                                        <button type="button" class="action-btn action-btn-danger js-delete cursor-pointer" data-id="@lecture.LectureId" data-type="lecture" title="حذف المحاضرة">
                                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr class="js-empty-row" style="display:none">
                            <td colspan="6" class="px-6 py-16 text-center text-slate-500">
                                <div class="flex flex-col items-center gap-3">
                                    <i data-lucide="search-x" class="w-12 h-12 text-slate-300"></i>
                                    <p class="font-semibold text-lg">لا توجد محاضرات مطابقة.</p>
                                    <p class="text-sm text-slate-400">حاول تغيير معايير البحث أو الفلترة، أو قم بإنشاء محاضرة جديدة.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>


    </div>
</div>

<!-- Edit Lecture Title Modal -->
<div id="editLectureModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden flex justify-center items-center overflow-y-auto">
    <div class="bg-white rounded-3xl w-full max-w-md mx-4 shadow-2xl overflow-hidden transform transition-all my-8">
        <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
            <h3 class="text-xl font-bold text-slate-800 flex items-center gap-2">
                <i data-lucide="pencil" class="w-5 h-5 text-primary"></i>
                تعديل اسم المحاضرة
            </h3>
            <button type="button" onclick="document.getElementById('editLectureModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600 transition-colors p-2 hover:bg-slate-100 rounded-full">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        <form asp-controller="Lecture" asp-action="Edit" method="post" class="p-6">
            <input type="hidden" id="editLectureId" name="lectureId" />
            <div class="space-y-5">
                <div>
                    <label for="editLectureTitle" class="block text-sm font-semibold text-slate-700 mb-2">اسم المحاضرة الجديد</label>
                    <input type="text" id="editLectureTitle" name="title" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-slate-900" placeholder="مثال: المحاضرة الأولى - مقدمة" />
                </div>
            </div>
            <div class="mt-8 flex gap-3">
                <button type="submit" class="flex-1 btn btn-primary py-2.5">
                    حفظ التعديل
                </button>
                <button type="button" onclick="document.getElementById('editLectureModal').classList.add('hidden')" class="flex-1 btn btn-neutral py-2.5">
                    إلغاء
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const editButtons = document.querySelectorAll('.js-edit-lecture');
        const editModal = document.getElementById('editLectureModal');
        const lectureIdInput = document.getElementById('editLectureId');
        const lectureTitleInput = document.getElementById('editLectureTitle');

        editButtons.forEach(btn => {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                const id = this.getAttribute('data-id');
                const title = this.getAttribute('data-title');

                lectureIdInput.value = id;
                lectureTitleInput.value = title;

                editModal.classList.remove('hidden');
            });
        });

        // AJAX removed as calculation is now purely instantaneous!
    });
</script>
