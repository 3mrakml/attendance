@{
    ViewData["Title"] = "مسح الغياب - " + ViewBag.LectureTitle;
}

<div class="space-y-8">
    <div class="text-center">
        <h2 class="text-3xl font-extrabold text-slate-800">مسح الغياب (QR Code)</h2>
        <p class="text-primary mt-2 text-lg font-bold bg-primary-light inline-block px-4 py-1 rounded-full border border-slate-200">@ViewBag.LectureTitle</p>
    </div>
    
    @if (ViewBag.IsClosed)
    {
        <div class="bg-rose-50 border border-rose-200 p-6 rounded-2xl max-w-2xl mx-auto shadow-sm">
            <div class="flex items-center justify-center flex-col text-center">
                <div class="w-16 h-16 bg-rose-100 text-rose-500 rounded-full flex items-center justify-center text-3xl mb-4">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <h3 class="text-xl font-bold text-rose-700 mb-2">الغياب مغلق</h3>
                <p class="text-rose-600">تم إغلاق تسجيل الحضور لهذه المحاضرة.</p>
            </div>
            <div class="text-center mt-6">
                <a asp-action="Index" asp-controller="Course" class="inline-block bg-slate-800 hover:bg-slate-900 text-white font-bold py-2.5 px-8 rounded-xl shadow-md transition-all">العودة للمواد</a>
            </div>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Right Side (RTL): Scanner Options -->
            <div class="space-y-6">
                <!-- Webcam Scanner -->
                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
                    <div class="bg-primary px-6 py-4 flex items-center">
                        <i class="bi bi-camera-video text-white text-xl ml-3"></i>
                        <h5 class="text-white font-bold text-lg m-0">المسح بالكاميرا</h5>
                    </div>
                    <div class="p-6 text-center bg-slate-50">
                        <div id="qr-reader" class="w-full max-w-md mx-auto bg-white rounded-xl overflow-hidden shadow-sm border border-slate-200"></div>
                        <p class="text-slate-500 mt-4 text-sm font-medium"><i class="bi bi-info-circle ml-1"></i>يرجى السماح بصلاحية الكاميرا لقراءة الباركود</p>
                    </div>
                </div>

                <!-- USB Scanner -->
                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
                    <div class="bg-slate-700 px-6 py-4 flex items-center">
                        <i class="bi bi-usb-symbol text-white text-xl ml-3"></i>
                        <h5 class="text-white font-bold text-lg m-0">الماسح الضوئي (إدخال يدوي)</h5>
                    </div>
                    <div class="p-6 bg-slate-50">
                        <div class="flex items-center justify-between mb-3">
                            <label for="usbScannerInput" class="block text-sm font-bold text-slate-700">اضغط هنا قبل المسح بجهاز الـ USB:</label>
                            <label class="inline-flex items-center cursor-pointer" title="تفعيل/إلغاء التركيز التلقائي على خانة المسح">
                                <input type="checkbox" id="autoFocusToggle" class="sr-only peer" checked>
                                <div class="relative w-9 h-5 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary"></div>
                                <span class="ms-2 text-xs font-semibold text-slate-600">التركيز التلقائي</span>
                            </label>
                        </div>
                        <div class="relative">
                            <i class="bi bi-upc-scan absolute top-1/2 right-4 transform -translate-y-1/2 text-slate-400 text-xl"></i>
                            <input type="text" id="usbScannerInput" class="w-full pr-12 pl-4 py-4 rounded-xl border-2 border-slate-200 focus:outline-none focus:border-primary focus:ring-4 focus:ring-primary/20 transition-all font-mono text-center text-lg" placeholder="قم بمسح الباركود أو إدخال الكود..." autofocus dir="ltr" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Left Side (RTL): Status Log -->
            <div class="h-full flex flex-col">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden flex-1 flex flex-col">
                    <div class="bg-emerald-500 px-6 py-4 flex justify-between items-center">
                        <div class="flex items-center">
                            <i class="bi bi-card-checklist text-white text-xl ml-3"></i>
                            <h5 class="text-white font-bold text-lg m-0">سجل الحضور</h5>
                        </div>
                        <span class="bg-white text-emerald-700 text-sm font-bold px-3 py-1 rounded-full shadow-sm" id="scanCount">0 تم مسحه</span>
                    </div>
                    <div class="p-4 flex-1 bg-slate-50/50 overflow-y-auto min-h-[400px] max-h-[600px]">
                        <ul id="scanLog" class="space-y-3">
                            @if (ViewBag.AttendedStudents != null && ((List<string>)ViewBag.AttendedStudents).Count > 0)
                            {
                                foreach (var name in ((List<string>)ViewBag.AttendedStudents).AsEnumerable().Reverse())
                                {
                                    <li class="p-4 rounded-xl bg-emerald-50 border border-emerald-100 text-emerald-800 text-sm flex items-start shadow-sm">
                                        <i class="bi bi-check-circle-fill text-emerald-500 ml-3 text-lg mt-0.5"></i>
                                        <div class="flex-1">
                                            <span class="block font-bold mb-1 opacity-75 text-xs">حضر مسبقاً</span>
                                            <span class="font-medium">@name</span>
                                        </div>
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="text-center text-slate-400 text-sm mt-10" id="emptyLogMsg">لم يتم مسح أي حضور بعد.</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-8 flex justify-center gap-4">
            <a href="@Url.Action("Students", "Lecture", new { id = ViewBag.LectureId })" class="btn btn-primary">
                <i class="bi bi-check-lg ml-2"></i>
                إنهاء المسح
            </a>
            <a href="@Url.Action("Students", "Lecture", new { id = ViewBag.LectureId })" class="btn btn-neutral">
                <i class="bi bi-people ml-2"></i>
                عرض الطلاب
            </a>
        </div>
    }
</div>

@section Scripts {
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
    
    <script>
        const lectureId = @ViewBag.LectureId;
        const scanLog = document.getElementById('scanLog');
        const scanCountEl = document.getElementById('scanCount');
        const usbScannerInput = document.getElementById('usbScannerInput');
        const emptyLogMsg = document.getElementById('emptyLogMsg');
        let scanCount = @(ViewBag.AttendedStudents != null ? ((List<string>)ViewBag.AttendedStudents).Count : 0);
        let isProcessing = false;
        
        // Update header on load
        scanCountEl.innerText = `${scanCount} تم مسحه`;

        // Initialize Web Audio API for reliable beeps
        let audioCtx;
        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        // Initialize on any user interaction to unlock audio
        document.addEventListener('click', initAudio, { once: true });
        document.addEventListener('keydown', initAudio, { once: true });

        function playBeep(isSuccess) {
            try {
                initAudio();
                const oscillator = audioCtx.createOscillator();
                const gainNode = audioCtx.createGain();

                oscillator.connect(gainNode);
                gainNode.connect(audioCtx.destination);

                if (isSuccess) {
                    // Short, high-pitched success beep (ding)
                    oscillator.type = 'sine';
                    oscillator.frequency.setValueAtTime(880, audioCtx.currentTime); // A5
                    oscillator.frequency.exponentialRampToValueAtTime(1760, audioCtx.currentTime + 0.1); // Slide to A6
                    gainNode.gain.setValueAtTime(0.5, audioCtx.currentTime);
                    gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.15);
                    oscillator.start(audioCtx.currentTime);
                    oscillator.stop(audioCtx.currentTime + 0.15);
                } else {
                    // Longer, low-pitched error beep (buzz)
                    oscillator.type = 'square';
                    oscillator.frequency.setValueAtTime(150, audioCtx.currentTime);
                    oscillator.frequency.exponentialRampToValueAtTime(100, audioCtx.currentTime + 0.3);
                    gainNode.gain.setValueAtTime(0.3, audioCtx.currentTime);
                    gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
                    oscillator.start(audioCtx.currentTime);
                    oscillator.stop(audioCtx.currentTime + 0.3);
                }
            } catch (e) {
                console.error("Audio playback failed:", e);
            }
        }

        function addLog(message, isSuccess) {
            if(emptyLogMsg) emptyLogMsg.style.display = 'none';
            
            const li = document.createElement('li');
            li.className = isSuccess
                ? "p-4 rounded-xl bg-emerald-50 border border-emerald-100 text-emerald-800 text-sm flex items-start shadow-sm"
                : "p-4 rounded-xl bg-rose-50 border border-rose-100 text-rose-800 text-sm flex items-start shadow-sm";
                
            const icon = isSuccess ? '<i class="bi bi-check-circle-fill text-emerald-500 ml-3 text-lg mt-0.5"></i>' : '<i class="bi bi-x-circle-fill text-rose-500 ml-3 text-lg mt-0.5"></i>';
            
            li.innerHTML = `
                ${icon}
                <div class="flex-1">
                    <span class="block font-bold mb-1 opacity-75 text-xs" dir="ltr">${new Date().toLocaleTimeString()}</span>
                    <span class="font-medium">${message}</span>
                </div>
            `;
            scanLog.prepend(li);
        }

        let lastScannedId = "";

        function processScanResult(decodedText) {
            if (isProcessing) return;
            const studentId = decodedText.trim();
            if (!studentId) return;

            // Prevent double-scanning the exact same card rapidly (within 2 seconds)
            if (lastScannedId === studentId) return;
            lastScannedId = studentId;
            setTimeout(() => { lastScannedId = ""; }, 2000);

            isProcessing = true;
            
            // 1. Instant Audio Feedback
            playBeep(true);
            
            // 2. Optimistic UI Log
            if(emptyLogMsg) emptyLogMsg.style.display = 'none';
            const optId = 'opt-' + Date.now();
            const li = document.createElement('li');
            li.id = optId;
            li.className = "p-4 rounded-xl bg-slate-50 border border-slate-200 text-slate-600 text-sm flex items-start shadow-sm animate-pulse";
            li.innerHTML = `
                <i class="bi bi-hourglass-split text-slate-400 ml-3 text-lg mt-0.5"></i>
                <div class="flex-1">
                    <span class="block font-bold mb-1 opacity-75 text-xs" dir="ltr">${new Date().toLocaleTimeString()}</span>
                    <span class="font-medium">جاري تسجيل (${studentId})...</span>
                </div>
            `;
            scanLog.prepend(li);

            fetch('/Lecture/RegisterAttendance', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ LectureId: lectureId, IdCollege: studentId })
            })
            .then(res => res.json())
            .then(data => {
                const optEl = document.getElementById(optId);
                if (optEl) optEl.remove(); // Remove optimistic log

                if (data.success) {
                    scanCount++;
                    scanCountEl.innerText = `${scanCount} تم مسحه`;
                    addLog(data.message, true);

                    Swal.fire({
                        toast: true,
                        position: 'top',
                        icon: 'success',
                        title: data.message,
                        showConfirmButton: false,
                        timer: 1000,
                        timerProgressBar: false,
                        showClass: { popup: '' }, // Disable show animation
                        hideClass: { popup: '' }  // Disable hide animation
                    });
                } else {
                    playBeep(false); // Play error buzz
                    addLog(data.message, false);

                    Swal.fire({
                        toast: true,
                        position: 'top',
                        icon: 'error',
                        title: data.message,
                        showConfirmButton: false,
                        timer: 1500,
                        timerProgressBar: false,
                        showClass: { popup: '' },
                        hideClass: { popup: '' }
                    });
                }
            })
            .catch(() => {
                const optEl = document.getElementById(optId);
                if (optEl) optEl.remove();

                playBeep(false);
                const errMsg = 'حدث خطأ في الاتصال بالخادم.';
                addLog(errMsg, false);
                Swal.fire({
                    toast: true,
                    position: 'top',
                    icon: 'error',
                    title: errMsg,
                    showConfirmButton: false,
                    timer: 1500,
                    timerProgressBar: false,
                    showClass: { popup: '' },
                    hideClass: { popup: '' }
                });
            })
            .finally(() => {
                isProcessing = false;
                if (usbScannerInput) {
                    usbScannerInput.value = '';
                    usbScannerInput.focus();
                }
            });
        }

        @if (!ViewBag.IsClosed) {
            <text>
            const html5QrCode = new Html5Qrcode("qr-reader");
            html5QrCode.start(
                { facingMode: "environment" },
                { fps: 10, qrbox: { width: 250, height: 250 } },
                (decodedText) => processScanResult(decodedText),
                (errorMessage) => { /* ignore frame errors */ }
            ).catch(err => {
                console.error("Camera start failed", err);
                document.getElementById("qr-reader").innerHTML = `<div class="p-4 text-rose-500 font-bold"><i class="bi bi-camera-video-off text-2xl block mb-2"></i>تعذر تشغيل الكاميرا. يرجى التأكد من السماح بالصلاحيات.</div>`;
            });
            </text>
        }

        if (usbScannerInput) {
            usbScannerInput.addEventListener('keypress', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    processScanResult(this.value);
                }
            });
            const autoFocusToggle = document.getElementById('autoFocusToggle');
            document.body.addEventListener('click', (e) => {
                // Respect the toggle. Ignore clicks on the QR reader, swal popups, or the toggle label itself.
                if (autoFocusToggle && autoFocusToggle.checked && 
                    !e.target.closest('#qr-reader') && 
                    !e.target.closest('.swal2-container') && 
                    !e.target.closest('label')) {
                    usbScannerInput.focus();
                }
            });
        }
    </script>
}
