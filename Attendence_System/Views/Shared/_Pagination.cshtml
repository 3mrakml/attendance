@model Attendence_System.ViewModel.PaginationInfo

@if (Model != null && Model.TotalPages > 1)
{
    string GetUrl(int page)
    {
        var routeValues = new RouteValueDictionary();
        foreach (var kvp in Model.RouteParams)
        {
            if (!string.IsNullOrEmpty(kvp.Value))
            {
                routeValues[kvp.Key] = kvp.Value;
            }
        }
        routeValues["page"] = page;

        if (string.IsNullOrEmpty(Model.Controller))
        {
            return Url.Action(Model.Action, routeValues);
        }
        else
        {
            return Url.Action(Model.Action, Model.Controller, routeValues);
        }
    }

    <div class="px-6 py-4 border-t border-slate-100 flex flex-col md:flex-row items-center justify-between bg-slate-50/50 gap-4">
        <div class="text-sm text-slate-500">
            عرض <span class="font-bold text-slate-900">@((Model.CurrentPage - 1) * 50 + 1)</span> 
            إلى <span class="font-bold text-slate-900">@(Math.Min(Model.CurrentPage * 50, Model.TotalItems))</span> 
            من أصل <span class="font-bold text-slate-900">@Model.TotalItems</span>
        </div>
        
        <div class="flex items-center gap-2">
            @if (Model.CurrentPage > 1)
            {
                <a href="@GetUrl(Model.CurrentPage - 1)" 
                   class="w-10 h-10 flex items-center justify-center rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-100 transition-colors">
                    <i data-lucide="chevron-right" class="w-4 h-4"></i>
                </a>
            }
            
            <div class="flex items-center gap-1">
                @{
                    int startPage = Math.Max(1, Model.CurrentPage - 2);
                    int endPage = Math.Min(Model.TotalPages, startPage + 4);
                    if (endPage - startPage < 4) { startPage = Math.Max(1, endPage - 4); }
                }
                
                @for (int p = startPage; p <= endPage; p++)
                {
                    <a href="@GetUrl(p)" 
                       class="w-10 h-10 flex items-center justify-center rounded-xl font-bold transition-all
                              @(p == Model.CurrentPage ? "bg-primary text-white shadow-md shadow-primary/20" : "text-slate-600 hover:bg-slate-100")">
                        @p
                    </a>
                }
            </div>

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a href="@GetUrl(Model.CurrentPage + 1)" 
                   class="w-10 h-10 flex items-center justify-center rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-100 transition-colors">
                    <i data-lucide="chevron-left" class="w-4 h-4"></i>
                </a>
            }
        </div>
    </div>
}
