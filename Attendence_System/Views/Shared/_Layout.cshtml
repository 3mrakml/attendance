<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام الحضور</title>

    <link href="~/css/tailwind.css" rel="stylesheet" />
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <script>
        (function() {
            try {
                var tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
                if (tz && document.cookie.indexOf('UserTimeZone=' + tz) === -1) {
                    document.cookie = 'UserTimeZone=' + tz + '; path=/; max-age=31536000; SameSite=Lax';
                    // تحديث الصفحة تلقائياً مرة واحدة إذا لم يكن الكوكيز موجوداً لضمان تحميل التوقيت الصحيح من السيرفر
                    if (document.cookie.indexOf('UserTimeZone=' + tz) !== -1 && !sessionStorage.getItem('tzRefreshed')) {
                        sessionStorage.setItem('tzRefreshed', '1');
                        window.location.reload();
                    }
                }
            } catch (e) { }
        })();
    </script>
</head>
<body class="bg-slate-50 min-h-screen flex flex-col lg:flex-row text-slate-800 overflow-x-hidden">

    <!-- Mobile Header -->
    <div class="lg:hidden flex items-center justify-between bg-white shadow-sm p-4 sticky top-0 z-30">
        <button id="mobile-menu-btn" class="p-2 rounded-lg bg-slate-100 text-slate-600 hover:bg-slate-200 focus:outline-none transition-colors">
            <i data-lucide="menu" class="w-6 h-6"></i>
        </button>
        <div class="flex items-center gap-3">
            <div>
                <h2 class="text-md font-bold text-slate-800">نظام الحضور</h2>
            </div>
            <img src="~/images/icon.png" class="w-10 h-10 rounded-lg shadow-sm border border-slate-100 object-cover" alt="Logo" />
        </div>
    </div>

    <!-- Mobile Sidebar Backdrop -->
    <div id="sidebar-backdrop" class="fixed inset-0 bg-slate-800/50 z-30 hidden lg:hidden backdrop-blur-sm transition-opacity opacity-0"></div>

    <!-- Glassmorphism Sidebar (RTL) -->
    <nav id="main-sidebar" class="w-64 bg-primary text-white border-l border-white/5 shadow-2xl fixed right-0 top-0 h-full flex flex-col z-40 transition-transform duration-300 translate-x-full lg:translate-x-0">
        <header class="p-6 flex items-center gap-3 border-b border-white/10 relative">
            <div class="relative flex-shrink-0">
                <img src="~/images/icon.png" class="w-14 h-14 rounded-xl shadow-lg object-cover" alt="Logo" />
            </div>
            <div class="flex-grow text-right pr-1">
                <h2 class="text-base font-bold text-white leading-tight">نظام الحضور</h2>
                <p class="text-xs text-slate-400 font-medium mt-1">الإدارة الذكية</p>
            </div>
            <!-- Close button for mobile -->
            <button id="close-sidebar-btn" class="lg:hidden flex-shrink-0 p-2 -ml-2 text-slate-400 hover:text-white hover:bg-white/10 rounded-lg transition-colors focus:outline-none">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </header>

        <ul class="flex-1 py-6 px-4 space-y-2 overflow-y-auto">
            <li>
                <a href="@Url.Action("Index", "Grade")" class="flex items-center px-4 py-3 rounded-xl transition-all duration-300 text-slate-300 hover:bg-white/10 hover:text-white hover:-translate-x-1 font-semibold group">
                    <div class="w-8 h-8 rounded-lg bg-white/10 text-slate-300 flex items-center justify-center ml-3 group-hover:bg-white/20 group-hover:text-white transition-colors">
                        <i data-lucide="graduation-cap" class="w-4 h-4"></i>
                    </div>
                    إدارة الصفوف
                </a>
            </li>
            <li>
                <a href="@Url.Action("Index", "Course")" class="flex items-center px-4 py-3 rounded-xl transition-all duration-300 text-slate-300 hover:bg-white/10 hover:text-white hover:-translate-x-1 font-semibold group">
                    <div class="w-8 h-8 rounded-lg bg-white/10 text-slate-300 flex items-center justify-center ml-3 group-hover:bg-white/20 group-hover:text-white transition-colors">
                        <i data-lucide="book-open" class="w-4 h-4"></i>
                    </div>
                    إدارة المواد
                </a>
            </li>
            <li>
                <a href="@Url.Action("Index", "Lecture")" class="flex items-center px-4 py-3 rounded-xl transition-all duration-300 text-slate-300 hover:bg-white/10 hover:text-white hover:-translate-x-1 font-semibold group">
                    <div class="w-8 h-8 rounded-lg bg-white/10 text-slate-300 flex items-center justify-center ml-3 group-hover:bg-white/20 group-hover:text-white transition-colors">
                        <i data-lucide="monitor-play" class="w-4 h-4"></i>
                    </div>
                    إدارة المحاضرات
                </a>
            </li>
            <li>
                <a href="@Url.Action("Index", "Student")" class="flex items-center px-4 py-3 rounded-xl transition-all duration-300 text-slate-300 hover:bg-white/10 hover:text-white hover:-translate-x-1 font-semibold group">
                    <div class="w-8 h-8 rounded-lg bg-white/10 text-slate-300 flex items-center justify-center ml-3 group-hover:bg-white/20 group-hover:text-white transition-colors">
                        <i data-lucide="users" class="w-4 h-4"></i>
                    </div>
                    إدارة الطلاب
                </a>
            </li>
            <li>
                <div class="relative">
                    <button onclick="toggleFormsMenu(this)" class="w-full flex items-center justify-between px-4 py-3 rounded-xl transition-all duration-300 text-slate-300 hover:bg-white/10 hover:text-white font-semibold group">
                        <span class="flex items-center">
                            <div class="w-8 h-8 rounded-lg bg-white/10 text-slate-300 flex items-center justify-center ml-3 group-hover:bg-white/20 group-hover:text-white transition-colors">
                                <i data-lucide="clipboard-list" class="w-4 h-4"></i>
                            </div>
                            نماذج
                        </span>
                        <i data-lucide="chevron-down" class="w-4 h-4 transition-transform forms-chevron"></i>
                    </button>
                    <div id="forms-submenu" class="hidden mt-1 mr-4 space-y-1 border-r-2 border-white/20 pr-2">
                        <a href="@Url.Action("Index", "AdminForms")" class="flex items-center gap-2 px-3 py-2.5 rounded-xl text-slate-400 hover:bg-white/10 hover:text-white transition-all text-sm font-semibold">
                            <i data-lucide="user-plus" class="w-4 h-4"></i> نموذج التسجيل
                        </a>
                        <a href="@Url.Action("GradesQuery", "AdminForms")" class="flex items-center gap-2 px-3 py-2.5 rounded-xl text-slate-400 hover:bg-white/10 hover:text-white transition-all text-sm font-semibold">
                            <i data-lucide="search" class="w-4 h-4"></i> استعلام الدرجات
                        </a>
                    </div>
                </div>
            </li>
            <li>
                <a href="@Url.Action("Index", "Exam")" class="flex items-center px-4 py-3 rounded-xl transition-all duration-300 text-slate-300 hover:bg-white/10 hover:text-white hover:-translate-x-1 font-semibold group">
                    <div class="w-8 h-8 rounded-lg bg-white/10 text-slate-300 flex items-center justify-center ml-3 group-hover:bg-white/20 group-hover:text-white transition-colors">
                        <i data-lucide="file-pen-line" class="w-4 h-4"></i>
                    </div>
                    الامتحانات
                </a>
            </li>
            <li>
                <div class="relative">
                    <button onclick="toggleReportsMenu(this)" class="w-full flex items-center justify-between px-4 py-3 rounded-xl transition-all duration-300 text-slate-300 hover:bg-white/10 hover:text-white font-semibold group">
                        <span class="flex items-center">
                            <div class="w-8 h-8 rounded-lg bg-white/10 text-slate-300 flex items-center justify-center ml-3 group-hover:bg-white/20 group-hover:text-white transition-colors">
                                <i data-lucide="chart-bar" class="w-4 h-4"></i>
                            </div>
                            التقارير
                        </span>
                        <i data-lucide="chevron-down" class="w-4 h-4 transition-transform reports-chevron"></i>
                    </button>
                    <div id="reports-submenu" class="hidden mt-1 mr-4 space-y-1 border-r-2 border-white/20 pr-2">
                        <a href="@Url.Action("Index", "Report")" class="flex items-center gap-2 px-3 py-2.5 rounded-xl text-slate-400 hover:bg-white/10 hover:text-white transition-all text-sm font-semibold">
                            <i data-lucide="pie-chart" class="w-4 h-4"></i> التقرير الشامل
                        </a>
                        <a href="@Url.Action("Attendance", "Report")" class="flex items-center gap-2 px-3 py-2.5 rounded-xl text-slate-400 hover:bg-white/10 hover:text-white transition-all text-sm font-semibold">
                            <i data-lucide="calendar-check" class="w-4 h-4"></i> تقرير الحضور
                        </a>
                        <a href="@Url.Action("Results", "Exam")" class="flex items-center gap-2 px-3 py-2.5 rounded-xl text-slate-400 hover:bg-white/10 hover:text-white transition-all text-sm font-semibold">
                            <i data-lucide="bar-chart-2" class="w-4 h-4"></i> نتائج الامتحانات
                        </a>
                    </div>
                </div>
            </li>
            <li>
                <a href="@Url.Action("Index", "Setting")" class="flex items-center px-4 py-3 rounded-xl transition-all duration-300 text-slate-300 hover:bg-white/10 hover:text-white hover:-translate-x-1 font-semibold group">
                    <div class="w-8 h-8 rounded-lg bg-white/10 text-slate-300 flex items-center justify-center ml-3 group-hover:bg-white/20 group-hover:text-white transition-colors">
                        <i data-lucide="settings" class="w-4 h-4"></i>
                    </div>
                    إعدادات النظام
                </a>
            </li>
        </ul>

        <div class="p-4 border-t border-white/30">
            <partial name="_LoginPartial" />
        </div>
    </nav>

    <!-- Main Content Area -->
    <div class="flex-1 lg:pr-64 flex flex-col min-h-screen min-w-0 overflow-x-hidden">

        <!-- Page Content -->
        <main role="main" class="p-4 lg:p-8 flex-1 w-full overflow-x-hidden">
            <div class="max-w-7xl mx-auto w-full">
                @RenderBody()
            </div>
        </main>
    </div>
    
    <!-- JavaScript -->
    <script src="~/js/jquery.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    <script src="~/js/Shared/Delete.js" asp-append-version="true"></script>
    <script src="~/js/Shared/site.js" asp-append-version="true"></script>
    <script>
        function toggleReportsMenu(btn) {
            const submenu = document.getElementById('reports-submenu');
            const chevron = btn.querySelector('.reports-chevron');
            submenu.classList.toggle('hidden');
            chevron.classList.toggle('rotate-180');
        }

        function toggleFormsMenu(btn) {
            const submenu = document.getElementById('forms-submenu');
            const chevron = btn.querySelector('.forms-chevron');
            submenu.classList.toggle('hidden');
            chevron.classList.toggle('rotate-180');
        }

        // Auto-open menus based on current page
        (function() {
            const path = window.location.pathname.toLowerCase();
            if (path.includes('/report') || (path.includes('/exam') && path.includes('/results'))) {
                const submenu = document.getElementById('reports-submenu');
                const chevron = document.querySelector('.reports-chevron');
                if (submenu) submenu.classList.remove('hidden');
                if (chevron) chevron.classList.add('rotate-180');
            }
            if (path.includes('/adminforms') || path.includes('/gradesquery')) {
                const submenu = document.getElementById('forms-submenu');
                const chevron = document.querySelector('.forms-chevron');
                if (submenu) submenu.classList.remove('hidden');
                if (chevron) chevron.classList.add('rotate-180');
            }
        })();
    </script>
    <script>
        $(document).ready(function() {
            // Sidebar logic
            const sidebar = $('#main-sidebar');
            const backdrop = $('#sidebar-backdrop');
            
            function openSidebar() {
                sidebar.removeClass('translate-x-full');
                backdrop.removeClass('hidden');
                // Small delay to allow display:block to apply before changing opacity
                setTimeout(() => backdrop.removeClass('opacity-0'), 10);
                $('body').addClass('overflow-hidden');
            }
            
            function closeSidebar() {
                sidebar.addClass('translate-x-full');
                backdrop.addClass('opacity-0');
                setTimeout(() => backdrop.addClass('hidden'), 300);
                $('body').removeClass('overflow-hidden');
            }

            $('#mobile-menu-btn').click(openSidebar);
            $('#close-sidebar-btn').click(closeSidebar);
            backdrop.click(closeSidebar);

            // Global SweetAlert styling & TempData handling
            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                customClass: {
                    popup: 'rounded-xl shadow-lg border border-slate-100',
                },
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer)
                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                }
            });

            @if (TempData["SuccessMessage"] != null)
            {
                <text>
                Toast.fire({
                    icon: 'success',
                    title: '@TempData["SuccessMessage"]'
                });
                </text>
            }
            
            @if (TempData["ErrorMessage"] != null)
            {
                <text>
                Swal.fire({
                    icon: 'error',
                    title: 'خطأ!',
                    text: '@TempData["ErrorMessage"]',
                    customClass: {
                        confirmButton: 'btn btn-primary',
                        popup: 'rounded-2xl shadow-xl border border-slate-100'
                    },
                    buttonsStyling: false
                });
                </text>
            }
        });
    </script>
    <script src="~/lib/lucide/lucide.min.js"></script>
    <script>
        lucide.createIcons();
    </script>
    <script src="~/js/Shared/global-prevent-submit.js" asp-append-version="true"></script>
    <script src="~/js/Shared/auto-filter.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
