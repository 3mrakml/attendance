<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام الحضور</title>
    <script src="~/lib/tailwindcss/tailwindcss.js"></script>
    <script src="~/lib/lucide/lucide.min.js"></script>
    <link href="~/lib/fonts/cairo.css" rel="stylesheet" />
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Cairo', 'sans-serif'],
                    },
                    colors: {
                        primary: '#3b82f6',
                        secondary: '#1e293b'
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Cairo', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 min-h-screen flex items-center justify-center p-4">

    <div class="w-full max-w-2xl bg-white rounded-3xl shadow-xl border border-slate-100 overflow-hidden">
        <div class="bg-slate-900 text-white p-6 text-center relative overflow-hidden">
            <div class="absolute inset-0 bg-blue-500/20 blur-3xl rounded-full translate-y-1/2"></div>
            <div class="relative z-10">
                <h1 class="text-2xl font-extrabold mb-1">@ViewData["Title"]</h1>
                @if (ViewData["Subtitle"] != null)
                {
                    <p class="text-slate-300 text-sm">@ViewData["Subtitle"]</p>
                }
            </div>
        </div>
        
        <div class="p-8">
            @RenderBody()
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
        });
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/global-prevent-submit.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
