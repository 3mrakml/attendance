<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام الحضور</title>
    <link rel="stylesheet" href="~/Attendence_System.styles.css" asp-append-version="true" />
    <link href="~/css/tailwind.css" rel="stylesheet" />
    <style>
        .glass-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
    </style>
</head>
<body class="bg-white text-slate-900 antialiased overflow-x-hidden">
    <main id="authPage" class="auth-page h-screen flex items-stretch overflow-hidden">
        <!-- Form Section -->
        <div class="w-full lg:w-[55%] flex flex-col justify-center px-8 md:px-16 lg:px-24 py-12 bg-white relative z-10 overflow-y-auto">
            <div class="max-w-md w-full mx-auto">
                <div class="mb-10">
                    <div class="flex items-center justify-between mb-8">
                        <a href="/" class="flex items-center gap-3 group">
                            <img src="~/images/icon.png" alt="نظام الحضور" class="w-10 h-10 object-cover rounded-lg shadow-sm border border-slate-100 transition-transform group-hover:scale-110">
                            <span class="text-3xl font-black tracking-tighter text-slate-800 uppercase group-hover:text-primary transition-all">الحضور</span>
                        </a>
                    </div>
                    <div class="text-right">
                        <h1 class="text-4xl font-extrabold text-slate-800 mb-3 tracking-tight">@ViewData["Title"]</h1>
                        <p class="text-slate-500 font-medium">@ViewData["Subtitle"]</p>
                    </div>
                </div>

                @RenderBody()

            </div>
        </div>

        <!-- Branding Section -->
        <div class="hidden lg:flex lg:w-[45%] relative overflow-hidden bg-[#0f1419] items-end justify-center p-12">
            @if (ViewData["AuthBgImage"] != null)
            {
                <img src="@Url.Content(ViewData["AuthBgImage"].ToString())" class="absolute inset-0 w-full h-full object-cover z-0 opacity-70" alt="خلفية الصفحة">
            }
            <div class="absolute inset-0 bg-gradient-to-t from-[#0f1419]/95 via-[#0f1419]/70 to-[#0f1419]/35 z-10"></div>

            <div class="relative z-20 max-w-xl text-right">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/10 text-white text-xs font-bold mb-8">
                    <span class="flex h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    @ViewData["BrandBadge"]
                </div>
                
                <h2 class="text-5xl font-black text-white mb-6 leading-tight tracking-tighter">
                    @Html.Raw(ViewData["BrandTitle"])
                </h2>
                
                <p class="text-xl text-slate-300 font-medium leading-relaxed mb-12">
                    @ViewData["BrandDescription"]
                </p>
                
                @if (ViewData["BrandShowFeatures"] != null && (bool)ViewData["BrandShowFeatures"])
                {
                    <div class="glass-card p-6 rounded-2xl">
                        <div class="space-y-4">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center text-emerald-400">
                                    <i data-lucide="check" class="w-5 h-5"></i>
                                </div>
                                <span class="text-white font-bold">تسجيل حضور ذكي وسريع بالباركود</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center text-emerald-400">
                                    <i data-lucide="check" class="w-5 h-5"></i>
                                </div>
                                <span class="text-white font-bold">تقارير وإحصائيات مفصلة لكل محاضرة</span>
                            </div>
                        </div>
                    </div>
                }

            </div>

            <!-- Decorative Elements -->
            <div class="absolute top-20 right-20 w-64 h-64 bg-slate-500/20 rounded-full blur-[120px]"></div>
            <div class="absolute bottom-20 left-20 w-96 h-96 bg-black rounded-full blur-[120px]"></div>
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/lucide/lucide.min.js"></script>
    <script>
        lucide.createIcons();
        function bindAuthInteractions() {
            const authPage = document.getElementById('authPage');
            if (!authPage) return;

            const toggleButtons = authPage.querySelectorAll('.toggle-password');
            toggleButtons.forEach(btn => {
                btn.addEventListener('click', function () {
                    const targetId = this.dataset.target;
                    const input = document.getElementById(targetId);
                    if (!input) return;
                    
                    const isPassword = input.type === 'password';
                    input.type = isPassword ? 'text' : 'password';
                    
                    const eyeOpen = this.querySelector('.eye-open');
                    const eyeClosed = this.querySelector('.eye-closed');
                    
                    if (isPassword) {
                        if(eyeOpen) eyeOpen.classList.add('hidden');
                        if(eyeClosed) eyeClosed.classList.remove('hidden');
                    } else {
                        if(eyeOpen) eyeOpen.classList.remove('hidden');
                        if(eyeClosed) eyeClosed.classList.add('hidden');
                    }
                });
            });

            // Set up transition direction on load
            const transitionDir = sessionStorage.getItem('auth_transition_dir');
            sessionStorage.removeItem('auth_transition_dir');
            
            if (transitionDir === 'left') {
                authPage.style.setProperty('--start-x', '30px');
            } else if (transitionDir === 'right') {
                authPage.style.setProperty('--start-x', '-30px');
            }

            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    authPage.classList.add('is-visible');
                });
            });

            authPage.querySelectorAll('.auth-switch-link').forEach((link) => {
                link.addEventListener('click', async function (e) {
                    const target = this.getAttribute('href');
                    if (!target || target.startsWith('#')) return;
                    const direction = this.dataset.direction === 'right' ? 'right' : 'left';
                    e.preventDefault();

                    sessionStorage.setItem('auth_transition_dir', direction);

                    authPage.classList.remove('is-visible');
                    authPage.classList.add(direction === 'left' ? 'is-leaving-left' : 'is-leaving-right');

                    setTimeout(() => window.location.href = target, 220);
                });
            });
        }
        bindAuthInteractions();
    </script>
    <script src="~/js/global-prevent-submit.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
