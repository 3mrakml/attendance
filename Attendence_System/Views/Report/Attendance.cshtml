@model List<Attendence_System.ViewModel.StudentReportItem>
@inject Attendence_System.Services.IHashidService Hashids
@{
    ViewData["Title"] = "تقرير الحضور";
    var grades = ViewBag.Grades as List<Attendence_System.Models.Grade>;
    int? selGrade = ViewBag.SelectedGradeId;
    var encodedSelGrade = selGrade.HasValue ? Hashids.Encode(selGrade.Value) : null;
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h2 class="text-3xl font-extrabold text-slate-800">تقرير الحضور</h2>
            <p class="text-slate-500 mt-1">نسبة حضور وغياب كل طالب</p>
        </div>
        <div class="flex gap-3 flex-wrap">
            <a href="@Url.Action("ExportAttendanceExcel", new { gradeId = encodedSelGrade })"
               class="btn bg-slate-800 hover:bg-slate-900 text-white shadow-md flex items-center gap-2">
                <i data-lucide="file-spreadsheet" class="w-4 h-4"></i> تصدير Excel
            </a>
        </div>
    </div>

    <!-- Filter -->
    <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-100">
        <form method="get" class="flex flex-wrap items-end gap-4">
            <div class="flex-1 min-w-[200px]">
                <label class="block text-sm font-semibold text-slate-700 mb-1">تصفية بالصف</label>
                <select name="gradeId" onchange="this.form.submit()"
                        class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-slate-800 focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition-all">
                    <option value="">-- جميع الصفوف --</option>
                    @if (grades != null)
                    {
                        foreach (var g in grades)
                        {
                            if (selGrade == g.GradeId)
                            { <option value="@Hashids.Encode(g.GradeId)" selected>@g.Name</option> }
                            else
                            { <option value="@Hashids.Encode(g.GradeId)">@g.Name</option> }
                        }
                    }
                </select>
            </div>
            @if (selGrade.HasValue)
            {
                <a href="@Url.Action("Attendance")" class="btn btn-neutral text-sm">✕ إلغاء الفلتر</a>
            }
        </form>
    </div>

    <!-- Stats -->
    @{
        int totalStudents = Model.Count;
        double avgAttendance = totalStudents > 0 ? Math.Round(Model.Average(s => s.AttendancePercentage), 1) : 0;
        int above80 = Model.Count(s => s.AttendancePercentage >= 80);
        int below50 = Model.Count(s => s.AttendancePercentage < 50);
    }
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm text-center">
            <div class="text-2xl font-black text-slate-800">@totalStudents</div>
            <div class="text-xs text-slate-500 mt-1">إجمالي الطلاب</div>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm text-center">
            <div class="text-2xl font-black text-primary">@avgAttendance%</div>
            <div class="text-xs text-slate-500 mt-1">متوسط الحضور</div>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-emerald-100 shadow-sm text-center">
            <div class="text-2xl font-black text-emerald-600">@above80</div>
            <div class="text-xs text-slate-500 mt-1">حضور ≥ 80%</div>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-rose-100 shadow-sm text-center">
            <div class="text-2xl font-black text-rose-600">@below50</div>
            <div class="text-xs text-slate-500 mt-1">حضور &lt; 50%</div>
        </div>
    </div>

    <!-- Table -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        @if (!Model.Any())
        {
            <div class="p-12 text-center text-slate-400">
                <i data-lucide="inbox" class="w-12 h-12 mx-auto mb-3 opacity-40"></i>
                <p>لا يوجد طلاب لعرضهم.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-slate-50 border-b border-slate-100 text-xs uppercase tracking-wider text-slate-500">
                        <tr>
                            <th class="px-4 py-3 text-right">#</th>
                            <th class="p-0 text-right hover:bg-slate-100 transition-colors"><a href="@Url.Action("Attendance", new { gradeId = encodedSelGrade, sortCol = 0, sortAsc = ViewBag.SortCol == 0 ? !(ViewBag.SortAsc ?? true) : true })" class="block px-4 py-3 w-full h-full">الاسم <i data-lucide="@(ViewBag.SortCol == 0 ? ((ViewBag.SortAsc ?? true) ? "arrow-up" : "arrow-down") : "arrow-up-down")" class="w-3 h-3 inline-block ml-1 @(ViewBag.SortCol == 0 ? "text-primary" : "opacity-40")"></i></a></th>
                            <th class="p-0 text-right hover:bg-slate-100 transition-colors"><a href="@Url.Action("Attendance", new { gradeId = encodedSelGrade, sortCol = 1, sortAsc = ViewBag.SortCol == 1 ? !(ViewBag.SortAsc ?? true) : true })" class="block px-4 py-3 w-full h-full">الصف <i data-lucide="@(ViewBag.SortCol == 1 ? ((ViewBag.SortAsc ?? true) ? "arrow-up" : "arrow-down") : "arrow-up-down")" class="w-3 h-3 inline-block ml-1 @(ViewBag.SortCol == 1 ? "text-primary" : "opacity-40")"></i></a></th>
                            <th class="p-0 text-center hover:bg-slate-100 transition-colors"><a href="@Url.Action("Attendance", new { gradeId = encodedSelGrade, sortCol = 2, sortAsc = ViewBag.SortCol == 2 ? !(ViewBag.SortAsc ?? true) : true })" class="block px-4 py-3 w-full h-full">المحاضرات <i data-lucide="@(ViewBag.SortCol == 2 ? ((ViewBag.SortAsc ?? true) ? "arrow-up" : "arrow-down") : "arrow-up-down")" class="w-3 h-3 inline-block ml-1 @(ViewBag.SortCol == 2 ? "text-primary" : "opacity-40")"></i></a></th>
                            <th class="p-0 text-center hover:bg-slate-100 transition-colors"><a href="@Url.Action("Attendance", new { gradeId = encodedSelGrade, sortCol = 3, sortAsc = ViewBag.SortCol == 3 ? !(ViewBag.SortAsc ?? true) : true })" class="block px-4 py-3 w-full h-full">حضور <i data-lucide="@(ViewBag.SortCol == 3 ? ((ViewBag.SortAsc ?? true) ? "arrow-up" : "arrow-down") : "arrow-up-down")" class="w-3 h-3 inline-block ml-1 @(ViewBag.SortCol == 3 ? "text-primary" : "opacity-40")"></i></a></th>
                            <th class="p-0 text-center hover:bg-slate-100 transition-colors"><a href="@Url.Action("Attendance", new { gradeId = encodedSelGrade, sortCol = 4, sortAsc = ViewBag.SortCol == 4 ? !(ViewBag.SortAsc ?? true) : true })" class="block px-4 py-3 w-full h-full">غياب <i data-lucide="@(ViewBag.SortCol == 4 ? ((ViewBag.SortAsc ?? true) ? "arrow-up" : "arrow-down") : "arrow-up-down")" class="w-3 h-3 inline-block ml-1 @(ViewBag.SortCol == 4 ? "text-primary" : "opacity-40")"></i></a></th>
                            <th class="p-0 text-center hover:bg-slate-100 transition-colors"><a href="@Url.Action("Attendance", new { gradeId = encodedSelGrade, sortCol = 5, sortAsc = ViewBag.SortCol == 5 ? !(ViewBag.SortAsc ?? true) : true })" class="block px-4 py-3 w-full h-full">نسبة الحضور <i data-lucide="@(ViewBag.SortCol == 5 ? ((ViewBag.SortAsc ?? true) ? "arrow-up" : "arrow-down") : "arrow-up-down")" class="w-3 h-3 inline-block ml-1 @(ViewBag.SortCol == 5 ? "text-primary" : "opacity-40")"></i></a></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        @{ int rowNum = (ViewBag.PaginationInfo.CurrentPage - 1) * 50; }
                        @foreach (var s in Model)
                        {
                            rowNum++;
                            bool good = s.AttendancePercentage >= 80;
                            bool warn = s.AttendancePercentage >= 50 && s.AttendancePercentage < 80;
                            string badgeClass = good ? "bg-emerald-50 text-emerald-700" : warn ? "bg-amber-50 text-amber-700" : "bg-rose-50 text-rose-700";
                            <tr class="hover:bg-slate-50/70 transition-colors">
                                <td class="px-4 py-3 text-slate-400 font-mono text-xs">@rowNum</td>
                                <td class="px-4 py-3 font-semibold text-slate-800">@s.FullName</td>
                                <td class="px-4 py-3 text-slate-600">@s.GradeName</td>
                                <td class="px-4 py-3 text-center text-slate-600">@s.TotalLectures</td>
                                <td class="px-4 py-3 text-center text-emerald-600 font-bold">@s.AttendedLectures</td>
                                <td class="px-4 py-3 text-center text-rose-600 font-bold">@s.AbsentLectures</td>
                                <td class="px-4 py-3 text-center">
                                    <div class="flex items-center justify-center gap-2">
                                        <div class="w-24 bg-slate-100 rounded-full h-1.5">
                                            <div class="h-1.5 rounded-full @(good ? "bg-emerald-500" : warn ? "bg-amber-400" : "bg-rose-500")"
                                                 style="width:@s.AttendancePercentage%"></div>
                                        </div>
                                        <span class="text-xs font-bold px-2 py-0.5 rounded-full @badgeClass">@s.AttendancePercentage%</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <partial name="_Pagination" model="ViewBag.PaginationInfo" />
        }
    </div>
</div>
