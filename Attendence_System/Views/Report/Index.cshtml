@model Attendence_System.ViewModel.ComprehensiveReportViewModel
@{
    ViewData["Title"] = "التقرير الشامل";
}

<div class="space-y-6">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h2 class="text-3xl font-extrabold text-slate-800">التقرير الشامل للحضور</h2>
            <p class="text-slate-500 mt-1">تتبع حضور وغياب الطلاب ودرجاتهم بشكل كامل.</p>
        </div>
        <div class="flex gap-3">
            <a id="exportExcelBtn" href="@Url.Action("ExportExcel", "Report", new { gradeId = Model.SelectedGradeId })" class="btn bg-slate-800 hover:bg-slate-900 text-white shadow-md">
                <i data-lucide="file-spreadsheet" class="w-4 h-4 ml-2"></i> تصدير Excel
            </a>
        </div>
    </div>

    <!-- Filter -->
    <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-100">
        <form method="get" asp-action="Index" class="flex gap-4 items-center">
            <div class="flex-grow max-w-sm relative">
                <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                    <i data-lucide="filter" class="w-5 h-5 text-slate-400"></i>
                </div>
                <select name="gradeId" class="w-full pr-12 pl-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 transition-all text-slate-900 bg-white" onchange="this.form.submit()">
                    <option value="">-- كل الصفوف --</option>
                    @if (ViewBag.Grades != null)
                    {
                        foreach (var grade in ViewBag.Grades)
                        {
                            if (Model.SelectedGradeId == grade.GradeId)
                            {
                                <option value="@grade.GradeId" selected>@grade.Name</option>
                            }
                            else
                            {
                                <option value="@grade.GradeId">@grade.Name</option>
                            }
                        }
                    }
                </select>
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i data-lucide="chevron-down" class="w-5 h-5 text-slate-400"></i>
                </div>
            </div>
            @if(Model.SelectedGradeId.HasValue)
            {
                <a href="@Url.Action("Index", "Report")" class="text-sm font-bold text-rose-500 hover:text-rose-600 transition-colors">إلغاء الفلتر</a>
            }
        </form>
    </div>

    <!-- Data Table -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-100">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="p-0 text-right text-xs font-bold text-slate-500 uppercase hover:bg-slate-100 transition-colors select-none group">
                            <a href="@Url.Action("Index", new { gradeId = Model.SelectedGradeId, sortCol = 0, sortAsc = ViewBag.SortCol == 0 ? !(ViewBag.SortAsc ?? true) : true })" class="block px-6 py-4 w-full h-full flex items-center">
                                اسم الطالب <i data-lucide="@(ViewBag.SortCol == 0 ? ((ViewBag.SortAsc ?? true) ? "arrow-up" : "arrow-down") : "arrow-up-down")" class="w-3 h-3 ml-1 transition-opacity @(ViewBag.SortCol == 0 ? "opacity-100 text-primary" : "opacity-0 group-hover:opacity-100")"></i>
                            </a>
                        </th>
                        <th class="p-0 text-right text-xs font-bold text-slate-500 uppercase hover:bg-slate-100 transition-colors select-none group">
                            <a href="@Url.Action("Index", new { gradeId = Model.SelectedGradeId, sortCol = 1, sortAsc = ViewBag.SortCol == 1 ? !(ViewBag.SortAsc ?? true) : true })" class="block px-6 py-4 w-full h-full flex items-center">
                                الصف <i data-lucide="@(ViewBag.SortCol == 1 ? ((ViewBag.SortAsc ?? true) ? "arrow-up" : "arrow-down") : "arrow-up-down")" class="w-3 h-3 ml-1 transition-opacity @(ViewBag.SortCol == 1 ? "opacity-100 text-primary" : "opacity-0 group-hover:opacity-100")"></i>
                            </a>
                        </th>
                        <th class="p-0 text-center text-xs font-bold text-slate-500 uppercase hover:bg-slate-100 transition-colors select-none group">
                            <a href="@Url.Action("Index", new { gradeId = Model.SelectedGradeId, sortCol = 2, sortAsc = ViewBag.SortCol == 2 ? !(ViewBag.SortAsc ?? true) : true })" class="block px-6 py-4 w-full h-full flex items-center justify-center">
                                إجمالي المحاضرات <i data-lucide="@(ViewBag.SortCol == 2 ? ((ViewBag.SortAsc ?? true) ? "arrow-up" : "arrow-down") : "arrow-up-down")" class="w-3 h-3 ml-1 transition-opacity @(ViewBag.SortCol == 2 ? "opacity-100 text-primary" : "opacity-0 group-hover:opacity-100")"></i>
                            </a>
                        </th>
                        <th class="p-0 text-center text-xs font-bold text-slate-500 uppercase hover:bg-slate-100 transition-colors select-none group">
                            <a href="@Url.Action("Index", new { gradeId = Model.SelectedGradeId, sortCol = 3, sortAsc = ViewBag.SortCol == 3 ? !(ViewBag.SortAsc ?? true) : true })" class="block px-6 py-4 w-full h-full flex items-center justify-center">
                                الحضور <i data-lucide="@(ViewBag.SortCol == 3 ? ((ViewBag.SortAsc ?? true) ? "arrow-up" : "arrow-down") : "arrow-up-down")" class="w-3 h-3 ml-1 transition-opacity @(ViewBag.SortCol == 3 ? "opacity-100 text-primary" : "opacity-0 group-hover:opacity-100")"></i>
                            </a>
                        </th>
                        <th class="p-0 text-center text-xs font-bold text-slate-500 uppercase hover:bg-slate-100 transition-colors select-none group">
                            <a href="@Url.Action("Index", new { gradeId = Model.SelectedGradeId, sortCol = 4, sortAsc = ViewBag.SortCol == 4 ? !(ViewBag.SortAsc ?? true) : true })" class="block px-6 py-4 w-full h-full flex items-center justify-center">
                                الغياب <i data-lucide="@(ViewBag.SortCol == 4 ? ((ViewBag.SortAsc ?? true) ? "arrow-up" : "arrow-down") : "arrow-up-down")" class="w-3 h-3 ml-1 transition-opacity @(ViewBag.SortCol == 4 ? "opacity-100 text-primary" : "opacity-0 group-hover:opacity-100")"></i>
                            </a>
                        </th>
                        <th class="p-0 text-center text-xs font-bold text-slate-500 uppercase hover:bg-slate-100 transition-colors select-none group">
                            <a href="@Url.Action("Index", new { gradeId = Model.SelectedGradeId, sortCol = 5, sortAsc = ViewBag.SortCol == 5 ? !(ViewBag.SortAsc ?? true) : true })" class="block px-6 py-4 w-full h-full flex items-center justify-center">
                                النسبة % <i data-lucide="@(ViewBag.SortCol == 5 ? ((ViewBag.SortAsc ?? true) ? "arrow-up" : "arrow-down") : "arrow-up-down")" class="w-3 h-3 ml-1 transition-opacity @(ViewBag.SortCol == 5 ? "opacity-100 text-primary" : "opacity-0 group-hover:opacity-100")"></i>
                            </a>
                        </th>
                        <th class="p-0 text-center text-xs font-bold text-slate-500 uppercase hover:bg-slate-100 transition-colors select-none group">
                            <a href="@Url.Action("Index", new { gradeId = Model.SelectedGradeId, sortCol = 6, sortAsc = ViewBag.SortCol == 6 ? !(ViewBag.SortAsc ?? true) : true })" class="block px-6 py-4 w-full h-full flex items-center justify-center">
                                درجة الحضور <i data-lucide="@(ViewBag.SortCol == 6 ? ((ViewBag.SortAsc ?? true) ? "arrow-up" : "arrow-down") : "arrow-up-down")" class="w-3 h-3 ml-1 transition-opacity @(ViewBag.SortCol == 6 ? "opacity-100 text-primary" : "opacity-0 group-hover:opacity-100")"></i>
                            </a>
                        </th>
                        <th class="p-0 text-center text-xs font-bold text-slate-500 uppercase hover:bg-slate-100 transition-colors select-none group">
                            <a href="@Url.Action("Index", new { gradeId = Model.SelectedGradeId, sortCol = 7, sortAsc = ViewBag.SortCol == 7 ? !(ViewBag.SortAsc ?? true) : true })" class="block px-6 py-4 w-full h-full flex items-center justify-center">
                                درجات الامتحانات <i data-lucide="@(ViewBag.SortCol == 7 ? ((ViewBag.SortAsc ?? true) ? "arrow-up" : "arrow-down") : "arrow-up-down")" class="w-3 h-3 ml-1 transition-opacity @(ViewBag.SortCol == 7 ? "opacity-100 text-primary" : "opacity-0 group-hover:opacity-100")"></i>
                            </a>
                        </th>
                        <th class="p-0 text-center text-xs font-bold text-primary uppercase hover:bg-primary/5 transition-colors select-none group">
                            <a href="@Url.Action("Index", new { gradeId = Model.SelectedGradeId, sortCol = 8, sortAsc = ViewBag.SortCol == 8 ? !(ViewBag.SortAsc ?? true) : true })" class="block px-6 py-4 w-full h-full flex items-center justify-center">
                                الدرجة الكلية <i data-lucide="@(ViewBag.SortCol == 8 ? ((ViewBag.SortAsc ?? true) ? "arrow-up" : "arrow-down") : "arrow-up-down")" class="w-3 h-3 ml-1 transition-opacity @(ViewBag.SortCol == 8 ? "opacity-100 text-primary" : "opacity-0 group-hover:opacity-100")"></i>
                            </a>
                        </th>
                    </tr>
                </thead>
                <tbody id="reportTableBody" class="divide-y divide-slate-100">
                    @if(Model.Students.Any())
                    {
                        @foreach(var student in Model.Students)
                        {
                            <tr class="hover:bg-slate-50/50 transition-colors">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="font-bold text-slate-900">@student.FullName</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-600">
                                    @student.GradeName
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center text-sm font-bold text-slate-500">
                                    @student.TotalLectures
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center text-sm font-bold text-emerald-600">
                                    @student.AttendedLectures
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center text-sm font-bold text-rose-500">
                                    @student.AbsentLectures
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    @{
                                        string badgeClass = student.AttendancePercentage >= 85 ? "bg-emerald-100 text-emerald-800" 
                                                          : student.AttendancePercentage >= 50 ? "bg-amber-100 text-amber-800" 
                                                          : "bg-rose-100 text-rose-800";
                                    }
                                    <span class="inline-flex px-3 py-1 rounded-full text-xs font-bold @badgeClass">
                                        @student.AttendancePercentage.ToString("0.00")%
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    <span class="inline-flex items-center justify-center min-w-[3rem] px-3 py-1.5 bg-primary/10 text-primary rounded-lg text-sm font-black border border-primary/20">
                                        @student.CalculatedScore.ToString("0.00")
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    <span class="inline-flex items-center justify-center min-w-[3rem] px-3 py-1.5 bg-violet-50 text-violet-700 rounded-lg text-sm font-black border border-violet-200">
                                        @student.ExamTotalScore.ToString("0.00")
                                        @if (student.ExamMaxScore > 0)
                                        {
                                            <span class="text-xs font-normal text-violet-400 mr-1">/ @student.ExamMaxScore.ToString("0")</span>
                                        }
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    <span class="inline-flex items-center justify-center min-w-[3rem] px-3 py-1.5 bg-emerald-600 text-white rounded-lg text-sm font-black shadow-sm">
                                        @student.TotalGrade.ToString("0.00")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="px-6 py-12 text-center text-slate-500 font-medium">
                                لا يوجد بيانات لعرضها.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <!-- Pagination -->
        <partial name="_Pagination" model="ViewBag.PaginationInfo" />
    </div>
</div>
