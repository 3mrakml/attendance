@{
    ViewData["Title"] = "إعدادات النظام";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <h1 class="text-3xl font-black text-slate-900 mb-2">إعدادات النظام ⚙️</h1>
        <p class="text-slate-500">إدارة التكوينات العامة للتطبيق</p>
    </div>
</div>

<div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden max-w-2xl">
    <div class="border-b border-slate-100 p-6 pb-4">
        <h3 class="text-xl font-bold text-slate-800">تكوينات التواريخ والحسابات</h3>
    </div>
    
    <form asp-controller="Setting" asp-action="Save" method="post" class="p-6 space-y-6">
        @Html.AntiForgeryToken()
        
        <div>
            <label for="AgeReferenceDate" class="block text-sm font-semibold text-slate-700 mb-2">التاريخ المرجعي لحساب السن</label>
            <input type="date" id="AgeReferenceDate" name="ageReferenceDate" value="@ViewBag.AgeReferenceDate" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-slate-900" dir="ltr" />
            <p class="text-xs text-slate-500 mt-2 leading-relaxed">
                هذا هو التاريخ الذي يتم الاعتماد عليه عند حساب سن الطلاب تلقائياً عند إضافة طالب جديد أو التعديل عليه (مثال: يتم حساب السن حتى 1 أكتوبر من العام الدراسي).
            </p>
        </div>

        <div class="border-t border-slate-100 pt-6">
            <label class="block text-sm font-semibold text-slate-700 mb-4">نوع الكود المستخدم للطلاب</label>
            <div class="flex flex-col sm:flex-row gap-6">
                <label class="flex items-center gap-3 cursor-pointer">
                    <input type="radio" name="codeType" value="QR" @(ViewBag.CodeType == "QR" || string.IsNullOrEmpty(ViewBag.CodeType) ? "checked" : "") class="w-5 h-5 text-primary border-slate-300 focus:ring-primary">
                    <span class="text-slate-800 font-medium flex items-center gap-2"><i data-lucide="qr-code" class="w-5 h-5 text-slate-500"></i> QR Code (مربع)</span>
                </label>
                <label class="flex items-center gap-3 cursor-pointer">
                    <input type="radio" name="codeType" value="Barcode" @(ViewBag.CodeType == "Barcode" ? "checked" : "") class="w-5 h-5 text-primary border-slate-300 focus:ring-primary">
                    <span class="text-slate-800 font-medium flex items-center gap-2"><i data-lucide="barcode" class="w-5 h-5 text-slate-500"></i> Barcode (شريطي)</span>
                </label>
            </div>
            <p class="text-xs text-slate-500 mt-3 leading-relaxed">
                سيؤثر هذا الخيار على عرض وطباعة الكود في شاشات الطلاب.
            </p>
        </div>

        <div class="border-t border-slate-100 pt-6">
            <label class="block text-sm font-semibold text-slate-700 mb-4">الدرجة النهائية للحضور</label>
            <p class="text-xs text-slate-500 mb-4 leading-relaxed">
                حدد الدرجة النهائية للحضور لكل صف. سيقوم النظام بحساب درجة الحضور النهائية للطالب (في التقرير الشامل واستعلام الطلاب) بناءً على نسبة حضوره من هذه الدرجة.
            </p>
            <div class="space-y-3 max-w-md">
                @if (ViewBag.Grades != null)
                {
                    foreach (var grade in ViewBag.Grades)
                    {
                        var settingsDict = ViewBag.GradeSettings as Dictionary<int, double>;
                        double maxMarks = settingsDict != null && settingsDict.ContainsKey(grade.GradeId) ? settingsDict[grade.GradeId] : 10;
                        
                        <div class="flex items-center justify-between p-4 bg-slate-50 rounded-xl border border-slate-200">
                            <span class="font-bold text-slate-700">@grade.Name</span>
                            <div class="w-32 relative">
                                <input type="number" step="0.5" min="0" name="marks[@grade.GradeId]" value="@maxMarks" class="w-full pl-4 pr-10 py-2 rounded-lg border border-slate-300 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary text-center font-bold" required />
                                <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-slate-400 text-sm font-bold">
                                    درجة
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="border-t border-slate-100 pt-6 flex justify-end">
            <button type="submit" class="btn btn-primary px-8">
                <i data-lucide="save" class="w-4 h-4 ml-2 inline-block"></i> حفظ الإعدادات
            </button>
        </div>
    </form>
</div>
