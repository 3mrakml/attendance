@model Attendence_System.ViewModel.CourseViewModel

<!-- Add Course Modal (Tailwind) -->
<div id="addCourseModal" class="hidden fixed inset-0 z-50 overflow-y-auto" aria-labelledby="addCourseModalLabel" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:p-0">
        <!-- Background overlay -->
        <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm transition-opacity" aria-hidden="true" onclick="document.getElementById('addCourseModal').classList.add('hidden')"></div>

        <!-- Modal panel -->
        <div class="relative bg-white rounded-2xl text-right overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:max-w-lg w-full">
            <div class="border-b border-slate-100 p-6 pb-4 flex justify-between items-center">
                <h5 class="text-xl font-bold text-slate-800" id="addCourseModalLabel">إضافة مادة جديدة</h5>
                <button type="button" class="text-slate-400 hover:text-slate-600 transition-colors" onclick="document.getElementById('addCourseModal').classList.add('hidden')">
                    <i class="bi bi-x-lg text-xl"></i>
                </button>
            </div>
            <form asp-controller="Course" asp-action="Index" method="post">
                @Html.AntiForgeryToken()
                <div class="p-6 space-y-4">
                    <div>
                        <label for="Name" class="block text-sm font-semibold text-slate-700 mb-2">اسم المادة</label>
                        <input type="text" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all text-slate-900" placeholder="مثال: برمجة متقدمة" id="Name" name="Name" required autofocus />
                    </div>
                    
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">تُدرس لـ (الصفوف)</label>
                        <div class="space-y-2 mt-2 max-h-48 overflow-y-auto p-2 border border-slate-200 rounded-xl bg-slate-50 text-right">
                            @if (Model.AvailableGrades != null)
                            {
                                @foreach (var grade in Model.AvailableGrades)
                                {
                                    <label class="flex items-center gap-3 cursor-pointer p-2 rounded-lg hover:bg-white transition-colors border border-transparent hover:border-slate-200">
                                        <input type="checkbox" name="SelectedGradeIds" value="@grade.GradeId" class="w-5 h-5 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500 focus:ring-2 cursor-pointer">
                                        <span class="text-slate-700 font-medium">@grade.Name</span>
                                    </label>
                                }
                            }
                            else
                            {
                                <div class="text-sm text-slate-500 p-2">لا توجد صفوف مضافة. يرجى إضافة صفوف دراسية أولاً.</div>
                            }
                        </div>
                    </div>
                </div>
                <div class="border-t border-slate-100 p-6 pt-4 flex gap-3">
                    <button type="button" class="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-2.5 rounded-xl transition-colors" onclick="document.getElementById('addCourseModal').classList.add('hidden')">إلغاء</button>
                    <button type="submit" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2.5 rounded-xl shadow-md transition-colors">إضافة</button>
                </div>
            </form>
        </div>
    </div>
</div>
