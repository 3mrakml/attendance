@model Attendence_System.ViewModel.CourseViewModel

<div class="space-y-8">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h2 class="text-3xl font-extrabold text-slate-800">إدارة المواد</h2>
            <p class="text-slate-500 mt-1">أضف مواد دراسية جديدة أو أدر المواد الحالية الخاصة بك.</p>
        </div>
        
        <!-- Add New Course Button -->
        <button type="button" onclick="document.getElementById('addCourseModal').classList.remove('hidden')" class="btn btn-primary">
            <i data-lucide="plus" class="w-4 h-4"></i>
            إضافة مادة جديدة
        </button>
    </div>

    <!-- Courses Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @if (Model.Courses != null && Model.Courses.Any())
        {
            @foreach (var course in Model.Courses)
            {
                <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100 hover:shadow-xl transition-all duration-300 group flex flex-col h-full relative overflow-hidden js-delete-parent">
                    <!-- Decorative element -->
                    <div class="absolute top-0 right-0 w-24 h-24 bg-gradient-to-bl from-primary/10 to-transparent rounded-bl-full -mr-4 -mt-4 opacity-50"></div>
                    
                    <div class="flex items-start justify-between mb-4 relative z-10">
                        <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center text-xl shadow-sm">
                            <i data-lucide="book-text" class="w-5 h-5"></i>
                        </div>
                        <div class="flex gap-2 z-20 relative">
                            <button type="button" class="action-btn action-btn-primary js-edit-course" 
                                    data-id="@Hashids.Encode(course.CourseId)" 
                                    data-name="@course.Name" 
                                    data-grades="@(course.CourseGrades != null ? string.Join(",", course.CourseGrades.Select(g => g.GradeId)) : "")" 
                                    title="تعديل المادة">
                                <i data-lucide="pencil" class="w-4 h-4"></i>
                            </button>
                            <button type="button" class="action-btn action-btn-danger js-delete" data-id="@Hashids.Encode(course.CourseId)" data-type="course" title="حذف المادة">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>
                    
                    <h3 class="text-xl font-bold text-slate-800 mb-2">@course.Name</h3>
                    
                    @if (course.CourseGrades != null && course.CourseGrades.Any())
                    {
                        <div class="flex flex-wrap gap-1 mb-3">
                            @foreach (var cg in course.CourseGrades)
                            {
                                <span class="px-2 py-1 bg-success/10 text-success text-xs font-bold rounded-md">@cg.Grade?.Name</span>
                            }
                        </div>
                    }
                    
                    <p class="text-slate-500 text-sm mb-6 flex-grow">إدارة المحاضرات وسجلات الحضور الخاصة بهذه المادة.</p>
                    
                    <form method="get" asp-controller="Course" asp-action="ViewLectures" asp-route-id="@Hashids.Encode(course.CourseId)" class="mt-auto w-full">
                        <button type="submit" class="btn btn-neutral w-full group/btn">
                            عرض المحاضرات
                            <i data-lucide="arrow-left" class="w-4 h-4 group-hover/btn:-translate-x-1 transition-transform"></i>
                        </button>
                    </form>
                </div>
            }
        }
        else
        {
            <div class="col-span-full text-center py-16 bg-white rounded-2xl border border-slate-200 border-dashed">
                <div class="w-20 h-20 bg-slate-50 text-slate-300 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl">
                    <i data-lucide="book-x" class="w-8 h-8"></i>
                </div>
                <h3 class="text-lg font-bold text-slate-700">لا توجد مواد مضافة بعد</h3>
                <p class="text-slate-500 mt-1 max-w-sm mx-auto">قم بإضافة مادتك الأولى لتبدأ في تسجيل حضور الطلاب وإدارة المحاضرات.</p>
                <button type="button" onclick="document.getElementById('addCourseModal').classList.remove('hidden')" class="btn btn-primary mt-6">
                    إضافة مادة الآن
                </button>
            </div>
        }
    </div>
</div>

<partial name="_AddCoursePartial" model="Model" />

<!-- Edit Course Modal -->
<div id="editCourseModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden flex justify-center items-center overflow-y-auto">
    <div class="bg-white rounded-3xl w-full max-w-md mx-4 shadow-2xl overflow-hidden transform transition-all my-8">
        <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
            <h3 class="text-xl font-bold text-slate-800 flex items-center gap-2">
                <i data-lucide="pencil" class="w-5 h-5 text-primary"></i>
                تعديل المادة
            </h3>
            <button type="button" onclick="document.getElementById('editCourseModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600 transition-colors p-2 hover:bg-slate-100 rounded-full">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        <form asp-controller="Course" asp-action="Edit" method="post" class="p-6">
            <input type="hidden" id="editCourseId" name="courseId" />
            <div class="space-y-5">
                <div>
                    <label for="editCourseName" class="block text-sm font-semibold text-slate-700 mb-2">اسم المادة</label>
                    <input type="text" id="editCourseName" name="Name" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-slate-900" placeholder="مثال: لغة عربية - مراجعة نهائية" />
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">الصفوف الدراسية المرتبطة بالمادة</label>
                    <div class="max-h-48 overflow-y-auto border border-slate-200 rounded-xl p-3 bg-slate-50/50">
                        @if (Model.AvailableGrades != null && Model.AvailableGrades.Any())
                        {
                            @foreach (var grade in Model.AvailableGrades)
                            {
                                <label class="flex items-center gap-3 p-2 hover:bg-slate-100 rounded-lg cursor-pointer transition-colors group">
                                    <input type="checkbox" name="selectedGradeIds" value="@grade.GradeId" class="w-4 h-4 text-primary bg-white border-slate-300 rounded focus:ring-primary edit-grade-checkbox" />
                                    <span class="text-slate-700 font-medium group-hover:text-slate-900">@grade.Name</span>
                                </label>
                            }
                        }
                        else
                        {
                            <p class="text-sm text-slate-500 text-center py-2">لا توجد صفوف مضافة. يرجى إضافة صفوف من إدارة الصفوف أولاً.</p>
                        }
                    </div>
                </div>
            </div>
            <div class="mt-8 flex gap-3">
                <button type="submit" class="flex-1 btn btn-primary py-2.5">
                    حفظ التعديلات
                </button>
                <button type="button" onclick="document.getElementById('editCourseModal').classList.add('hidden')" class="flex-1 btn btn-neutral py-2.5">
                    إلغاء
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const editButtons = document.querySelectorAll('.js-edit-course');
        const editModal = document.getElementById('editCourseModal');
        const courseIdInput = document.getElementById('editCourseId');
        const courseNameInput = document.getElementById('editCourseName');
        const gradeCheckboxes = document.querySelectorAll('.edit-grade-checkbox');

        editButtons.forEach(btn => {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                const id = this.getAttribute('data-id');
                const name = this.getAttribute('data-name');
                const gradesStr = this.getAttribute('data-grades') || '';
                const gradesArr = gradesStr.split(',');

                courseIdInput.value = id;
                courseNameInput.value = name;

                // Reset all checkboxes
                gradeCheckboxes.forEach(cb => {
                    cb.checked = false;
                    if (gradesArr.includes(cb.value)) {
                        cb.checked = true;
                    }
                });

                editModal.classList.remove('hidden');
            });
        });
    });
</script>
