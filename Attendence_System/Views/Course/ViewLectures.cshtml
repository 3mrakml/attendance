@model Attendence_System.ViewModel.LectureWithCourse

@{
    ViewData["Title"] = "عرض المحاضرات";
}

<div class="space-y-8">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-slate-500 mb-1">
                <a href="@Url.Action("Index", "Course")" class="hover:text-primary transition-colors">إدارة المواد</a>
                <i class="bi bi-chevron-left text-xs"></i>
                <span class="text-slate-400">محاضرات المادة</span>
            </div>
            <h2 class="text-3xl font-extrabold text-slate-800">مادة @Model.CouresName</h2>
        </div>
        
        <form method="get" asp-controller="Course" asp-action="Attendance" asp-route-id="@Hashids.Encode(Model.CourseId.Value)">
            <button type="submit" class="btn btn-success w-full md:w-auto">
                <i data-lucide="bar-chart-2" class="w-4 h-4"></i>
                إحصائيات الحضور للمادة
            </button>
        </form>
    </div>

    <!-- Filter and Search Section -->
    <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-100 flex flex-col md:flex-row gap-4 mb-6">
        <div class="relative flex-grow">
            <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                <i data-lucide="search" class="w-4 h-4 text-slate-400"></i>
            </div>
            <input type="text" id="searchInput" class="w-full pl-4 pr-10 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary text-slate-900 transition-all" placeholder="ابحث باسم المحاضرة...">
        </div>
        <div class="w-full md:w-64">
            <select id="gradeFilter" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary text-slate-900 transition-all">
                <option value="all">كل الصفوف</option>
                @{
                    var uniqueGrades = Model.Lectures
                        ?.SelectMany(l => l.LectureGrades)
                        .Select(lg => lg.Grade?.Name)
                        .Where(n => n != null)
                        .Distinct() ?? new List<string>();
                    foreach (var gradeName in uniqueGrades)
                    {
                        <option value="@gradeName">@gradeName</option>
                    }
                }
            </select>
        </div>
    </div>

    <!-- Lectures Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8" id="lecturesGrid">
        @if (Model.Lectures != null && Model.Lectures.Any())
        {
            @foreach (var lecture in Model.Lectures)
            {
                <div class="lecture-card bg-white rounded-2xl p-6 shadow-sm border border-slate-100 hover:shadow-xl transition-all duration-300 group flex flex-col h-full relative overflow-hidden js-delete-parent"
                     data-title="@lecture.Title"
                     data-grade="@string.Join(",", lecture.LectureGrades?.Select(lg => lg.Grade?.Name ?? "") ?? new List<string>())">
                    <div class="flex items-start justify-between mb-4 relative z-10">
                        <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center text-xl shadow-sm">
                            <i data-lucide="monitor-play" class="w-5 h-5"></i>
                        </div>
                        <button type="button" class="action-btn action-btn-danger js-delete cursor-pointer" data-id="@Hashids.Encode(lecture.LectureId)" data-type="lecture" title="حذف المحاضرة">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                        </button>
                    </div>
                    
                    <h3 class="text-xl font-bold text-slate-800 mb-2">@lecture.Title</h3>
                    @if (lecture.LectureGrades != null && lecture.LectureGrades.Any())
                    {
                        <div class="mb-3 flex flex-wrap gap-1">
                            @foreach (var lg in lecture.LectureGrades)
                            {
                                <span class="inline-block px-3 py-1 bg-amber-50 text-amber-600 text-xs font-bold rounded-lg border border-amber-100">
                                    <i class="bi bi-mortarboard ml-1"></i> @(lg.Grade?.Name ?? "")
                                </span>
                            }
                        </div>
                    }
                    
                    <p class="text-slate-500 text-sm mb-6 flex-grow">تفاصيل المحاضرة والطلاب الحاضرين.</p>
                    
                    <div class="grid grid-cols-2 gap-3 mt-auto">
                        <a asp-controller="Lecture" asp-action="Scan" asp-route-id="@Hashids.Encode(lecture.LectureId)" class="btn btn-success">
                            <i data-lucide="scan-line" class="w-4 h-4"></i> جهاز المسح
                        </a>
                        <form method="get" asp-controller="Lecture" asp-action="Students" asp-route-id="@Hashids.Encode(lecture.LectureId)" class="w-full">
                            <button type="submit" class="btn btn-neutral w-full group/btn">
                                الطلاب
                                <i data-lucide="arrow-left" class="w-4 h-4 group-hover/btn:-translate-x-1 transition-transform"></i>
                            </button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-span-full text-center py-16 bg-white rounded-2xl border border-slate-200 border-dashed" id="emptyState">
                <div class="w-20 h-20 bg-slate-50 text-slate-300 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl">
                    <i data-lucide="video-off" class="w-8 h-8"></i>
                </div>
                <h3 class="text-lg font-bold text-slate-700">لا توجد محاضرات في هذه المادة</h3>
                <p class="text-slate-500 mt-1">قم بإنشاء محاضرة جديدة للبدء في أخذ الغياب.</p>
                <a href="@Url.Action("Create", "Lecture")" class="btn btn-primary mt-6 inline-flex">
                    إنشاء محاضرة الآن
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchInput');
            const gradeFilter = document.getElementById('gradeFilter');
            const lectureCards = document.querySelectorAll('.lecture-card');
            
            function filterLectures() {
                const searchTerm = searchInput.value.toLowerCase();
                const selectedGrade = gradeFilter.value;
                
                lectureCards.forEach(card => {
                    const title = card.getAttribute('data-title').toLowerCase();
                    const grade = card.getAttribute('data-grade');
                    
                    const matchesSearch = title.includes(searchTerm);
                    // grade data attribute يمكن أن يحتوي على أكثر من صف مفصولة بفاصلة
                    const grades = card.getAttribute('data-grade').split(',');
                    const matchesGrade = selectedGrade === 'all' || grades.includes(selectedGrade);

                    if (matchesSearch && matchesGrade) {
                        card.style.display = '';
                    } else {
                        card.style.display = 'none';
                    }
                });
            }
            
            if (searchInput && gradeFilter) {
                searchInput.addEventListener('input', filterLectures);
                gradeFilter.addEventListener('change', filterLectures);
            }
        });
    </script>
}
