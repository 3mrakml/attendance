@model Attendence_System.Models.Student

@{
    ViewData["Title"] = "تسجيل بيانات";
    ViewData["Subtitle"] = "أدخل بياناتك للحصول على بطاقة الحضور الخاصة بك.";
    Layout = "_PublicLayout";
}

<form asp-action="Register" method="post" class="space-y-6">
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="bg-rose-50 text-rose-500 p-4 rounded-xl text-sm font-medium border border-rose-100">
            يرجى مراجعة البيانات المدخلة وتصحيح الأخطاء.
        </div>
    }

    <!-- Full Name -->
    <div>
        <label asp-for="FullName" class="block text-sm font-semibold text-slate-700 mb-2">الاسم الرباعي</label>
        <div class="relative">
            <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                <i data-lucide="user" class="w-5 h-5 text-slate-400"></i>
            </div>
            <input asp-for="FullName" type="text" class="w-full pl-4 pr-12 py-3.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-slate-900" placeholder="الاسم بالكامل" required />
        </div>
        <span asp-validation-for="FullName" class="text-rose-500 text-xs mt-1 block font-medium"></span>
    </div>

    <!-- Phone Number (used to retrieve card if registered) -->
    <div>
        <label asp-for="PhoneNumber" class="block text-sm font-semibold text-slate-700 mb-2">رقم الهاتف (الواتس آب)</label>
        <div class="relative">
            <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                <i data-lucide="phone" class="w-5 h-5 text-slate-400"></i>
            </div>
            <input asp-for="PhoneNumber" type="text" class="w-full pl-4 pr-12 py-3.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-slate-900 text-left" placeholder="01xxxxxxxxx" required dir="ltr" />
        </div>
        <span asp-validation-for="PhoneNumber" class="text-rose-500 text-xs mt-1 block font-medium"></span>
        <p class="text-xs text-slate-400 mt-1">مهم: سيُستخدم رقم الهاتف لاسترجاع الكارنيه الخاص بك لاحقاً.</p>
    </div>

    <div class="grid grid-cols-2 gap-4">
        <!-- Age -->
        <div>
            <label asp-for="Age" class="block text-sm font-semibold text-slate-700 mb-2">السن</label>
            <div class="relative">
                <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                    <i data-lucide="calendar" class="w-5 h-5 text-slate-400"></i>
                </div>
                <input asp-for="Age" type="number" min="10" max="100" class="w-full pl-4 pr-12 py-3.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-slate-900 text-left" placeholder="عمرك" required dir="ltr" />
            </div>
            <span asp-validation-for="Age" class="text-rose-500 text-xs mt-1 block font-medium"></span>
        </div>

        <!-- Grade -->
        <div>
            <label asp-for="GradeId" class="block text-sm font-semibold text-slate-700 mb-2">الصف / الفرقة</label>
            <div class="relative">
                <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                    <i data-lucide="graduation-cap" class="w-5 h-5 text-slate-400"></i>
                </div>
                <select asp-for="GradeId" asp-items="@(new SelectList(ViewBag.Grades, "GradeId", "Name"))" class="w-full pl-10 pr-12 py-3.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-slate-900 appearance-none bg-white" required>
                    <option value="">-- اختر --</option>
                </select>
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i data-lucide="chevron-down" class="w-5 h-5 text-slate-400"></i>
                </div>
            </div>
            <span asp-validation-for="GradeId" class="text-rose-500 text-xs mt-1 block font-medium"></span>
        </div>
    </div>

    <button type="submit" class="w-full py-3.5 px-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold flex items-center justify-center gap-2 transition-all shadow-lg shadow-slate-900/30">
        تسجيل وبدء الاستخدام <i data-lucide="arrow-left" class="w-5 h-5"></i>
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
