@model Attendence_System.Models.Student

@{
    ViewData["Title"] = "تسجيل بيانات";
    ViewData["Subtitle"] = "أدخل بياناتك للحصول على بطاقة الحضور الخاصة بك.";
    Layout = "_PublicLayout";
}

<form asp-action="Register" method="post" class="space-y-6">
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="bg-rose-50 text-rose-500 p-4 rounded-xl text-sm font-medium border border-rose-100">
            يرجى مراجعة البيانات المدخلة وتصحيح الأخطاء.
        </div>
    }

    <!-- Full Name -->
    <div>
        <label asp-for="FullName" class="block text-sm font-semibold text-slate-700 mb-2">الاسم الرباعي</label>
        <div class="relative">
            <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                <i data-lucide="user" class="w-5 h-5 text-slate-400"></i>
            </div>
            <input asp-for="FullName" type="text" class="w-full pl-4 pr-12 py-3.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-slate-900" placeholder="الاسم بالكامل" required />
        </div>
        <span asp-validation-for="FullName" class="text-rose-500 text-xs mt-1 block font-medium"></span>
    </div>

    @if (ViewBag.ShowPhoneNumberField == true)
    {
        <!-- Phone Number (used to retrieve card if registered) -->
        <div>
            <label asp-for="PhoneNumber" class="block text-sm font-semibold text-slate-700 mb-2">رقم الهاتف (الواتس آب)</label>
            <div class="relative">
                <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                    <i data-lucide="phone" class="w-5 h-5 text-slate-400"></i>
                </div>
                <input asp-for="PhoneNumber" type="text" class="w-full pl-4 pr-12 py-3.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-slate-900 text-left" placeholder="01xxxxxxxxx" required dir="ltr" />
            </div>
            <span asp-validation-for="PhoneNumber" class="text-rose-500 text-xs mt-1 block font-medium"></span>
            <p class="text-xs text-slate-400 mt-1">مهم: سيُستخدم رقم الهاتف لاسترجاع الكارنيه الخاص بك لاحقاً.</p>
        </div>
    }

    @if (ViewBag.ShowDateOfBirthField == true)
    {
        <!-- Date of Birth -->
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">تاريخ الميلاد</label>
            <div class="flex gap-2" dir="ltr">
                <input type="number" id="DobDay" placeholder="DD" min="1" max="31" class="w-full px-3 py-3.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 text-center text-slate-900" required />
                <span class="flex items-center text-slate-400">/</span>
                <input type="number" id="DobMonth" placeholder="MM" min="1" max="12" class="w-full px-3 py-3.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 text-center text-slate-900" required />
                <span class="flex items-center text-slate-400">/</span>
                <input type="number" id="DobYear" placeholder="YYYY" min="1900" max="2100" class="w-full px-3 py-3.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 text-center text-slate-900" required />
            </div>
            <input type="hidden" id="DateOfBirth" name="DateOfBirth" />
            <p id="DobError" class="text-xs text-rose-500 mt-1 hidden font-medium">تاريخ غير صحيح. تأكد من توافق الأيام مع الشهر.</p>
        </div>
    }

    @if (ViewBag.ShowAgeField == true)
    {
        <!-- Age (Manual - Optional) -->
        <div>
            <label asp-for="Age" class="block text-sm font-semibold text-slate-700 mb-2">السن (يدوي - اختياري)</label>
            <div class="relative">
                <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                    <i data-lucide="calendar" class="w-5 h-5 text-slate-400"></i>
                </div>
                <input type="number" id="Age" name="Age" min="0" max="120" class="w-full pl-4 pr-12 py-3.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-slate-900 text-left" placeholder="اتركه فارغاً لو هتدخل تاريخ ميلاد" dir="ltr" />
            </div>
            <span asp-validation-for="Age" class="text-rose-500 text-xs mt-1 block font-medium"></span>
        </div>
    }
    else
    {
        <input type="hidden" id="Age" name="Age" />
    }

    @if (ViewBag.ShowGradeField == true)
    {
        <!-- Grade -->
        <div>
            <label asp-for="GradeId" class="block text-sm font-semibold text-slate-700 mb-2">الصف / الفرقة</label>
            <div class="relative">
                <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                    <i data-lucide="graduation-cap" class="w-5 h-5 text-slate-400"></i>
                </div>
                <select id="GradeId" asp-for="GradeId" class="w-full pl-10 pr-12 py-3.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all text-slate-900 appearance-none bg-white" required>
                    <option value="">-- اختر --</option>
                    @if (ViewBag.Grades != null)
                    {
                        foreach (var grade in ViewBag.Grades)
                        {
                            <option value="@grade.GradeId" data-minage="@grade.MinAge" data-maxage="@grade.MaxAge">@grade.Name</option>
                        }
                    }
                </select>
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i data-lucide="chevron-down" class="w-5 h-5 text-slate-400"></i>
                </div>
            </div>
            <span asp-validation-for="GradeId" class="text-rose-500 text-xs mt-1 block font-medium"></span>
        </div>
    }

    <button type="submit" class="w-full py-3.5 px-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold flex items-center justify-center gap-2 transition-all shadow-lg shadow-slate-900/30">
        تسجيل وبدء الاستخدام <i data-lucide="arrow-left" class="w-5 h-5"></i>
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            var globalRefDate = '@(ViewBag.AgeReferenceDate ?? "")';

            function autoSelectGrade(ageVal, gradeIdSelector) {
                if (ageVal === '' || isNaN(ageVal) || !gradeIdSelector) return;
                var age = parseInt(ageVal);
                var foundMatch = false;

                $(gradeIdSelector + ' option').each(function() {
                    if (!$(this).val()) return true;

                    var minAttr = $(this).attr('data-minage');
                    var maxAttr = $(this).attr('data-maxage');
                    
                    if (!minAttr && !maxAttr) return true;

                    var min = minAttr ? parseInt(minAttr) : 0;
                    var max = maxAttr ? parseInt(maxAttr) : 1000;
                    
                    if (age >= min && age <= max) {
                        $(gradeIdSelector).val($(this).val());
                        foundMatch = true;
                        return false;
                    }
                });

                if (!foundMatch) {
                    $(gradeIdSelector).val('');
                }
            }

            function calcAndSetAge() {
                var dob = $('#DateOfBirth').val();
                if (!dob) return;
                
                var refDate = (globalRefDate && globalRefDate.trim() !== '') ? new Date(globalRefDate) : new Date();
                var birth = new Date(dob);
                var age = refDate.getFullYear() - birth.getFullYear();
                var m = refDate.getMonth() - birth.getMonth();
                
                if (m < 0 || (m === 0 && refDate.getDate() < birth.getDate())) {
                    age--;
                }
                
                if (age >= 0 && age <= 120) {
                    $('#Age').val(age);
                    autoSelectGrade(age, '#GradeId');
                }
            }

            function validateAndSetDob() {
                var d = $('#DobDay').val();
                var m = $('#DobMonth').val();
                var y = $('#DobYear').val();
                
                $('#DobError').addClass('hidden');
                
                if(d && m && y) {
                    var dateObj = new Date(y, m - 1, d);
                    if(dateObj.getFullYear() == y && dateObj.getMonth() == m - 1 && dateObj.getDate() == d) {
                        var formattedStr = y + '-' + m.toString().padStart(2, '0') + '-' + d.toString().padStart(2, '0');
                        $('#DateOfBirth').val(formattedStr);
                        calcAndSetAge();
                        $(this).closest('form').find('button[type="submit"]').prop('disabled', false);
                    } else {
                        $('#DobError').removeClass('hidden');
                        $('#DateOfBirth').val('');
                        $(this).closest('form').find('button[type="submit"]').prop('disabled', true);
                    }
                } else {
                    $('#DateOfBirth').val('');
                }
            }

            $('#DobDay, #DobMonth, #DobYear').on('change keyup', validateAndSetDob);
            
            // Allow auto-select grade if user types age manually
            $('#Age').on('change keyup', function() {
                var ageVal = $(this).val();
                if(ageVal) {
                    autoSelectGrade(ageVal, '#GradeId');
                }
            });
        });
    </script>
}
