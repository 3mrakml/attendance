@model Attendence_System.Models.Student
@using Attendence_System.Models
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "التقرير الشامل للطالب";
    ViewData["Subtitle"] = $"كود: {Model.QRToken}";

    var studentExams = ViewBag.StudentExams as List<StudentExam> ?? new List<StudentExam>();
    var allLectures = ViewBag.AllLectures as List<Lecture> ?? new List<Lecture>();
    var attendedLectureIds = ViewBag.AttendedLectureIds as List<int> ?? new List<int>();

    int totalLectures = ViewBag.TotalLectures ?? 0;
    int attendedLectures = ViewBag.AttendedLectures ?? 0;

    double totalExamMax = studentExams.Where(se => se.Score.HasValue && se.Exam != null).Sum(se => se.Exam!.MaxScore);
    double totalExamEarned = studentExams.Where(se => se.Score.HasValue).Sum(se => se.Score!.Value);

    double attendanceMaxMarks = ViewBag.AttendanceMaxMarks ?? 10.0;
    double attendanceScore = ViewBag.AttendanceScore ?? 0.0;

    double grandTotalMax = totalExamMax + attendanceMaxMarks;
    double grandTotalEarned = totalExamEarned + attendanceScore;

    double overallPct = grandTotalMax > 0 ? (grandTotalEarned / grandTotalMax) * 100 : 0;
}

<!-- Student Info -->
<div class="flex items-center gap-4 bg-slate-50 p-4 rounded-2xl mb-6">
    <div class="w-16 h-16 rounded-full bg-gradient-to-br from-primary to-blue-700 flex items-center justify-center text-white text-2xl flex-shrink-0">
        <i data-lucide="graduation-cap" class="w-8 h-8"></i>
    </div>
    <div>
        <h2 class="text-xl font-black text-slate-800">@Model.FullName</h2>
        <div class="flex gap-2 mt-1">
            <span class="text-sm text-slate-500 font-semibold">📞 <span dir="ltr">@Model.PhoneNumber</span></span>
            @if (Model.Grade != null)
            {
                <span class="text-sm bg-primary/10 text-primary px-2 py-0.5 rounded-lg font-bold">@Model.Grade.Name</span>
            }
        </div>
    </div>
</div>

<!-- Overall Score -->
<div class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-2xl p-6 text-white mb-8 shadow-lg relative overflow-hidden">
    <div class="absolute top-0 right-0 w-32 h-32 bg-white/5 rounded-full blur-2xl -translate-y-1/2 translate-x-1/2"></div>
    <div class="relative z-10 flex justify-between items-center">
        <div>
            <p class="text-slate-300 font-bold mb-1">التقييم العام</p>
            <div class="text-3xl font-black">
                @grandTotalEarned <span class="text-lg text-slate-400 font-bold">/ @grandTotalMax</span>
            </div>
        </div>
        <div class="text-right">
            <div class="text-4xl font-black @(overallPct >= 85 ? "text-emerald-400" : overallPct >= 50 ? "text-amber-400" : "text-rose-400")">
                @Math.Round(overallPct, 1)%
            </div>
            <p class="text-sm text-slate-400 font-semibold">@(overallPct >= 50 ? "ناجح" : "راسب")</p>
        </div>
    </div>
</div>

<!-- Stats Grid -->
<div class="grid grid-cols-2 gap-4 mb-8">
    <!-- Attendance Stat -->
    <div class="bg-white border border-slate-100 rounded-2xl p-4 shadow-sm">
        <div class="flex items-center justify-between mb-2">
            <h3 class="font-bold text-slate-700 text-sm">الحضور</h3>
            <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center">
                <i data-lucide="check-circle-2" class="w-4 h-4"></i>
            </div>
        </div>
        <div class="text-2xl font-black text-slate-800">
            @attendanceScore <span class="text-sm text-slate-400">/ @attendanceMaxMarks</span>
        </div>
        <div class="text-xs text-slate-500 font-semibold mt-1 mb-1">
            (حضر @attendedLectures من @totalLectures محاضرات)
        </div>
        <div class="w-full bg-slate-100 rounded-full h-1.5 mt-2">
            <div class="bg-emerald-500 h-1.5 rounded-full" style="width: @(totalLectures > 0 ? (attendedLectures * 100 / totalLectures) : 0)%"></div>
        </div>
    </div>

    <!-- Exams Stat -->
    <div class="bg-white border border-slate-100 rounded-2xl p-4 shadow-sm">
        <div class="flex items-center justify-between mb-2">
            <h3 class="font-bold text-slate-700 text-sm">الامتحانات</h3>
            <div class="w-8 h-8 rounded-lg bg-indigo-100 text-indigo-600 flex items-center justify-center">
                <i data-lucide="file-text" class="w-4 h-4"></i>
            </div>
        </div>
        <div class="text-2xl font-black text-slate-800">
            @totalExamEarned <span class="text-sm text-slate-400">/ @totalExamMax</span>
        </div>
        <div class="w-full bg-slate-100 rounded-full h-1.5 mt-3">
            <div class="bg-indigo-500 h-1.5 rounded-full" style="width: @(totalExamMax > 0 ? (totalExamEarned * 100 / totalExamMax) : 0)%"></div>
        </div>
    </div>
</div>

<!-- Exams List -->
<div class="mb-8">
    <h3 class="text-lg font-black text-slate-800 mb-4 flex items-center gap-2">
        <i data-lucide="award" class="w-5 h-5 text-indigo-500"></i> تفاصيل الامتحانات
    </h3>
    @if (!studentExams.Any())
    {
        <div class="text-center p-6 bg-slate-50 rounded-2xl text-slate-500 font-semibold border border-slate-100">
            لا توجد امتحانات مسجلة.
        </div>
    }
    else
    {
        <div class="space-y-3">
            @foreach (var se in studentExams)
            {
                var exam = se.Exam;
                if (exam == null) continue;

                bool hasScore = se.Score.HasValue;
                double pct = hasScore && exam.MaxScore > 0 ? (se.Score!.Value / exam.MaxScore) * 100 : 0;
                bool passed = pct >= 50;

                <div class="bg-white border border-slate-100 rounded-xl p-4 flex items-center justify-between shadow-sm">
                    <div>
                        <h4 class="font-bold text-slate-800">@exam.Title</h4>
                        <div class="flex items-center gap-2 mt-1 text-xs font-semibold text-slate-500">
                            @if (exam.Course != null)
                            {
                                <span class="bg-slate-100 px-2 py-0.5 rounded text-slate-600">@exam.Course.Name</span>
                            }
                            else
                            {
                                <span class="bg-fuchsia-50 text-fuchsia-600 px-2 py-0.5 rounded border border-fuchsia-100">امتحان شامل</span>
                            }
                            <span dir="ltr">@exam.Date.ToString("yyyy-MM-dd")</span>
                        </div>
                    </div>
                    <div class="text-center">
                        <div class="font-black text-lg @(!hasScore ? "text-slate-400" : passed ? "text-emerald-600" : "text-rose-600")">
                            @(hasScore ? se.Score!.Value.ToString() : "—") <span class="text-xs text-slate-400">/ @exam.MaxScore</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Attendance List -->
<div class="mb-6">
    <h3 class="text-lg font-black text-slate-800 mb-4 flex items-center gap-2">
        <i data-lucide="calendar-check" class="w-5 h-5 text-emerald-500"></i> سجل الحضور
    </h3>
    @if (!allLectures.Any())
    {
        <div class="text-center p-6 bg-slate-50 rounded-2xl text-slate-500 font-semibold border border-slate-100">
            لا يوجد سجل حضور.
        </div>
    }
    else
    {
        <div class="space-y-2">
            @foreach (var lec in allLectures.Take(10))
            {
                bool isPresent = attendedLectureIds.Contains(lec.LectureId);

                <div class="flex justify-between items-center bg-white border border-slate-100 p-3 rounded-xl">
                    <div class="flex items-center gap-3">
                        @if (isPresent)
                        {
                            <div class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center">
                                <i data-lucide="check" class="w-4 h-4"></i>
                            </div>
                        }
                        else
                        {
                            <div class="w-8 h-8 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center">
                                <i data-lucide="x" class="w-4 h-4"></i>
                            </div>
                        }
                        <div>
                            <div class="font-bold text-sm text-slate-800">محاضرة @(lec.Course?.Name ?? "بدون مادة")</div>
                            <div class="text-xs text-slate-500 font-semibold" dir="ltr">@lec.DateTime.ToString("yyyy-MM-dd")</div>
                        </div>
                    </div>
                    <div class="font-bold text-sm @(isPresent ? "text-emerald-600" : "text-rose-600")">
                        @(isPresent ? "حاضر" : "غائب")
                    </div>
                </div>
            }
            @if (allLectures.Count > 10)
            {
                <div class="text-center text-sm font-semibold text-slate-400 mt-2">
                    تم إظهار آخر 10 محاضرات فقط.
                </div>
            }
        </div>
    }
</div>

<div class="pt-4 border-t border-slate-100">
    <a href="javascript:history.back()" class="w-full btn btn-neutral py-3 flex justify-center items-center gap-2">
        <i data-lucide="arrow-right" class="w-4 h-4"></i> عودة للاستعلام
    </a>
</div>
