@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "استعلام عن الدرجات";
    ViewData["Subtitle"] = "أدخل كود QR الخاص بك أو رقم هاتفك للاطلاع على درجاتك وحضورك";
}

@if (ViewBag.NotFound == true)
{
    <div class="bg-rose-50 border-2 border-rose-200 text-rose-700 rounded-2xl p-4 flex items-center justify-center gap-3 mb-6 text-center">
        <i data-lucide="alert-circle" class="w-6 h-6 flex-shrink-0"></i>
        <div class="font-bold">
            لم يتم العثور على طالب بهذا الكود أو رقم التليفون.<br />
            تأكد من الكود وحاول مرة أخرى.
        </div>
    </div>
}

<form method="post" class="space-y-6">
    @Html.AntiForgeryToken()
    
    <div>
        <label for="query" class="block font-bold text-slate-700 mb-2">كود QR أو رقم التليفون</label>
        <div class="relative">
            <input type="text" id="query" name="query" value="@ViewBag.Query"
                   placeholder="مثال: 1001 أو 010XXXXXXXX"
                   dir="ltr" autofocus
                   class="w-full pl-4 pr-12 py-3 rounded-xl border-2 border-slate-200 focus:outline-none focus:ring-4 focus:ring-primary/15 focus:border-primary transition-all font-mono text-center text-lg font-bold text-slate-800" />
            <i data-lucide="search" class="w-6 h-6 text-slate-400 absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none"></i>
        </div>
        <p class="text-sm text-slate-500 text-center mt-2 font-semibold">يمكنك إدخال الرقم الموجود على كارنيه الطالب أو رقم الهاتف المسجل</p>
    </div>

    <button type="submit" class="w-full bg-primary hover:bg-blue-600 text-white font-black text-lg py-4 rounded-xl shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all flex justify-center items-center gap-2">
        استعلام الآن
        <i data-lucide="arrow-left" class="w-5 h-5"></i>
    </button>
</form>
