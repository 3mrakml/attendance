@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>استعلام عن الدرجات</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Cairo', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 50%, #0f172a 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .card {
            background: white;
            border-radius: 24px;
            padding: 40px 36px;
            width: 100%;
            max-width: 480px;
            box-shadow: 0 25px 60px rgba(0,0,0,0.4);
        }
        .logo {
            width: 64px; height: 64px;
            background: linear-gradient(135deg, #3b82f6, #1d4ed8);
            border-radius: 16px;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 20px;
            font-size: 28px;
        }
        h1 { text-align: center; font-size: 1.6rem; font-weight: 900; color: #0f172a; margin-bottom: 6px; }
        p.sub { text-align: center; color: #64748b; font-size: 0.9rem; margin-bottom: 28px; }
        label { display: block; font-weight: 700; font-size: 0.9rem; color: #374151; margin-bottom: 8px; }
        input[type=text] {
            width: 100%;
            padding: 14px 16px;
            border: 2px solid #e2e8f0;
            border-radius: 14px;
            font-size: 1.1rem;
            font-family: 'Cairo', monospace;
            text-align: center;
            letter-spacing: 0.05em;
            transition: border 0.2s;
            outline: none;
        }
        input[type=text]:focus { border-color: #3b82f6; box-shadow: 0 0 0 4px rgba(59,130,246,0.15); }
        .hint { font-size: 0.8rem; color: #94a3b8; text-align: center; margin-top: 8px; }
        button[type=submit] {
            width: 100%;
            margin-top: 20px;
            padding: 14px;
            background: linear-gradient(135deg, #3b82f6, #1d4ed8);
            color: white;
            border: none;
            border-radius: 14px;
            font-size: 1.05rem;
            font-weight: 700;
            font-family: 'Cairo', sans-serif;
            cursor: pointer;
            transition: transform 0.1s, box-shadow 0.2s;
        }
        button[type=submit]:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(59,130,246,0.4); }
        button[type=submit]:active { transform: translateY(0); }

        .error-box {
            background: #fef2f2;
            border: 1.5px solid #fca5a5;
            border-radius: 14px;
            padding: 16px 20px;
            color: #b91c1c;
            font-weight: 700;
            text-align: center;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="card">
        <div class="logo">🎓</div>
        <h1>استعلام عن الدرجات</h1>
        <p class="sub">أدخل كود QR الخاص بك أو رقم هاتفك للاطلاع على درجاتك</p>

        @if (ViewBag.NotFound == true)
        {
            <div class="error-box">
                ⚠️ لم يتم العثور على طالب بهذا الكود أو رقم التليفون.<br />
                تأكد من الكود وحاول مرة أخرى.
            </div>
        }

        <form method="post">
            @Html.AntiForgeryToken()
            <label for="query">كود QR أو رقم التليفون</label>
            <input type="text" id="query" name="query" value="@ViewBag.Query"
                   placeholder="مثال: 1001 أو 010XXXXXXXX"
                   dir="ltr" autofocus />
            <div class="hint">يمكنك إدخال الرقم الموجود على كارنيه الطالب أو رقم الهاتف المسجل</div>
            <button type="submit">🔍 استعلام</button>
        </form>
    </div>
</body>
</html>
